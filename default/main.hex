import
    Hello from c "main.h"
end

let heap: Heap = Heap()

unsafe do
    let pointer: Ptr<Byte> | Nil = Hello.hello_world()
    if pointer != nil then
        let length: Size = Hello.hello_world_length()
        let bytes: Slice<Byte> = pointer.to_slice(length)
        let message: String = bytes.to<String>(heap)
        print(message)
        message.free(heap)
    end
end
