    {
      "description": "Use load, store, and fetch_add on an atomic object member shared by pointer.",
      "entrypoint": "app.hex",
      "features": [
        "atomics",
        "objects",
        "pointers"
      ],
      "id": "concurrency-atomic-counter",
      "name": "Atomic counter",
      "reservedWords": [
        "type",
        "mut",
        "fun",
        "@",
        "return",
        "end",
        "do"
      ],
      "sources": {
        "app.hex": [
          "type Shared is struct count: Atomic\u003cInt32\u003e end",
          "fun bump(shared: Ptr\u003cmut Shared\u003e) do",
          "    shared.count.fetch_add(1)",
          "end",
          "fun run(): Int32 do",
          "    mut shared: Shared:= Shared(count = Atomic\u003cInt32\u003e(0))",
          "    pointer: Ptr\u003cmut Shared\u003e:= @shared",
          "    pointer.count.store(5)",
          "    pointer.count.fetch_add(1)",
          "    bump(pointer)",
          "    return pointer.count.load()",
          "end"
        ]
      }
    },
    {
      "description": "Show why every repeating path through a task-reachable while true must execute Task.yield().",
      "entrypoint": "app.hex",
      "features": [
        "tasks",
        "while"
      ],
      "id": "concurrency-yield-loop",
      "name": "Cooperative yield",
      "reservedWords": [
        "fun",
        "while",
        "true",
        "do",
        "if",
        "break",
        "end",
        "try",
        "spawn",
        "return",
        "then"
      ],
      "sources": {
        "app.hex": [
          "fun worker(): Bool do",
          "    while true do",
          "        if false then",
          "            break",
          "        end",
          "        Task.yield()",
          "    end",
          "    return true",
          "end",
          "fun run(): Int32 | Error do",
          "    task: Task\u003cBool\u003e:= try spawn worker()",
          "    task.join()",
          "    return 0",
          "end"
        ]
      }
    },
