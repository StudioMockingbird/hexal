      "id": "concurrency-spawn-join",
      "name": "Spawn and join",
      "description": "Spawn a typed function and return its joined result.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun square(value: Int32): Int32 do",
        "    return value * value",
        "end",
        "fun run(): Int32 | Error do",
        "    task: Task<Int32>:= try spawn square(6)",
        "    return task.join()",
        "end"
