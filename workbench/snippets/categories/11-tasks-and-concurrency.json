    },
    {
      "id": "concurrency-mutex-critical-section",
      "name": "Mutex critical section",
      "description": "Lock and unlock a heap-backed mutex around a short operation.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun run(h: Heap): Nil | Error",
        "    mutex: Mutex = try Mutex.new(h)",
        "    defer mutex.free(h)",
        "    mut total: Int32 = 0",
        "    mutex.lock()",
        "    total = total + 1",
        "    mutex.unlock()",
        "    return nil",
        "end"
      ]},
      "features": ["mutex", "errors", "defer"],
      "reservedWords": ["fun", "mut", "try", "defer", "return", "nil", "end"]
    },
    {
      "id": "concurrency-atomic-counter",
      "name": "Atomic counter",
      "description": "Use load, store, and fetch_add on an atomic object member shared by pointer.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Shared = { count: Atomic<Int32>, }",
        "fun bump(shared: MutPtr<Shared>)",
        "    shared.count.fetch_add(1)",
        "end",
        "fun run(): Int32",
        "    mut shared: Shared = Shared { count = Atomic<Int32>.new(0) }",
        "    pointer: MutPtr<Shared> = ref shared",
        "    pointer.count.store(5)",
        "    pointer.count.fetch_add(1)",
        "    bump(pointer)",
        "    return pointer.count.load()",
        "end"
      ]},
      "features": ["atomics", "objects", "pointers"],
      "reservedWords": ["type", "mut", "fun", "ref", "return", "end"]
    },
    {
      "id": "concurrency-yield-loop",
      "name": "Cooperative yield",
      "description": "Show why every repeating path through a task-reachable while true must execute Task.yield().",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun worker(): Bool",
        "    while true do",
        "        if false",
        "            break",
        "        end",
        "        Task.yield()",
        "    end",
        "    return true",
        "end",
        "fun run(): Int32 | Error",
        "    task: Task<Bool> = try spawn worker()",
        "    task.join()",
        "    return 0",
        "end"
      ]},
      "features": ["tasks", "while"],
      "reservedWords": ["fun", "while", "true", "do", "if", "break", "end", "try", "spawn", "return"]
    },
    {
      "id": "concurrency-worker-handoff",
      "name": "Worker handoff",
      "description": "Send work through a channel and receive the result.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun worker(channel: Channel<Int32>): Bool",
        "    channel.send(40 + 2)",
        "    channel.close()",
        "    return true",
        "end",
        "fun run(h: Heap): Int32 | Error",
        "    channel: Channel<Int32> = try Channel<Int32>.new(h, 2)",
        "    defer channel.free(h)",
        "    task: Task<Bool> = try spawn worker(channel)",
        "    task.join()",
        "    step: Int32 | EoS = channel.receive()",
        "    if step is Int32",
        "        return step",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["tasks", "channels", "errors", "defer"],
      "reservedWords": ["fun", "try", "defer", "spawn", "if", "is", "return", "end"]
    },
    {
      "id": "concurrency-concurrent-cleanup",
      "name": "Concurrent cleanup",
      "description": "Combine task creation with deferred channel or mutex cleanup.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun worker(mutex: Mutex): Bool",
        "    mutex.lock()",
        "    mutex.unlock()",
        "    return true",
        "end",
        "fun run(h: Heap): Int32 | Error",
        "    mutex: Mutex = try Mutex.new(h)",
        "    defer mutex.free(h)",
        "    task: Task<Bool> = try spawn worker(mutex)",
        "    task.join()",
        "    return 0",
        "end"
      ]},
      "features": ["tasks", "mutex", "errors", "defer"],
      "reservedWords": ["fun", "try", "defer", "spawn", "return", "end"]
    }
  ]
}
