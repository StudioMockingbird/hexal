{
  "id": "tasks-and-concurrency",
  "name": "Tasks and Concurrency",
  "snippets": [
    {
      "id": "concurrency-spawn-join",
      "name": "Spawn and join",
      "description": "Spawn a typed function and return its joined result.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun square(value: Int32): Int32",
        "    return value * value",
        "end",
        "fun run(): Int32 | Error",
        "    task: Task<Int32> = try spawn square(6)",
        "    return task.join()",
        "end"
      ]},
      "features": ["tasks", "errors"],
      "reservedWords": ["fun", "return", "end", "try", "spawn"]
    },
    {
      "id": "concurrency-two-tasks",
      "name": "Two tasks",
      "description": "Spawn two independent calculations and combine results.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun square(value: Int32): Int32",
        "    return value * value",
        "end",
        "fun run(): Int32 | Error",
        "    first: Task<Int32> = try spawn square(3)",
        "    second: Task<Int32> = try spawn square(4)",
        "    return first.join() + second.join()",
        "end"
      ]},
      "features": ["tasks", "errors"],
      "reservedWords": ["fun", "return", "end", "try", "spawn"]
    },
    {
      "id": "concurrency-channel-send",
      "name": "Channel send",
      "description": "Create a bounded channel, send a value, and close it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun run(h: Heap): Nil | Error",
        "    channel: Channel<Int32> = try Channel<Int32>.new(h, 4)",
        "    defer channel.free(h)",
        "    channel.send(1)",
        "    channel.send(2)",
        "    channel.close()",
        "    return nil",
        "end"
      ]},
      "features": ["channels", "errors", "defer"],
      "reservedWords": ["fun", "try", "defer", "return", "nil", "end"]
    },
    {
      "id": "concurrency-channel-receive",
      "name": "Channel receive",
      "description": "Receive a value and distinguish it from EoS.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun run(h: Heap): Int32 | Error",
        "    channel: Channel<Int32> = try Channel<Int32>.new(h, 2)",
        "    defer channel.free(h)",
        "    channel.send(7)",
        "    channel.close()",
        "    step: Int32 | EoS = channel.receive()",
        "    if step is Int32",
        "        return step",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["channels", "errors", "defer"],
      "reservedWords": ["fun", "try", "defer", "if", "is", "return", "end"]
    },
    {
      "id": "concurrency-channel-round-trip",
      "name": "Channel round trip",
      "description": "Send a computed value through a channel and consume it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun run(h: Heap): Int32 | Error",
        "    channel: Channel<Int32> = try Channel<Int32>.new(h, 2)",
        "    defer channel.free(h)",
        "    channel.send(20 + 22)",
        "    channel.close()",
        "    step: Int32 | EoS = channel.receive()",
        "    if step is Int32",
