    {
      "description": "Queue 128 CPU-bound fibers so the runtime's one-worker-per-logical-processor scheduler can occupy all available workers.",
      "entrypoint": "app.hex",
      "features": [
        "tasks",
        "lists",
        "while",
        "for",
        "errors",
        "try-errdefer",
        "heap-allocation"
      ],
      "id": "concurrency-cpu-saturating-fibers",
      "name": "CPU-saturating M:N fibers",
      "reservedWords": [
        "fun",
        "mut",
        "while",
        "do",
        "end",
        "return",
        "try",
        "spawn",
        "for",
        "in",
        "nil"
      ],
      "sources": {
        "app.hex": [
          "fun burn(seed: Int64): Int64 do",
          "    mut value: Int64:= seed",
          "    mut step: Int64:= 0",
          "    while step \u003c 1000000 do",
          "        value = ((value * 31) + step) % 1000003",
          "        step = step + 1",
          "    end",
          "    return value",
          "end",
          "fun saturate(h: Heap): Nil | Error do",
          "    jobs: List\u003cTask\u003cInt64\u003e\u003e:= List\u003cTask\u003cInt64\u003e\u003e(h)",
          "    defer jobs.free(h)",
          "    mut seed: Int64:= 0",
          "    while seed \u003c 128 do",
          "        jobs.push(try spawn burn(seed))",
          "        seed = seed + 1",
          "    end",
          "    for job in jobs do",
          "        job.join()",
          "    end",
          "    return nil",
          "end",
          "saturate(Heap())"
        ]
      }
    },
