    {
      "description": "Inspect channel length, capacity, and closed state around a receive.",
      "entrypoint": "app.hex",
      "features": [
        "channels",
        "errors",
        "defer",
        "unions",
        "truthiness"
      ],
      "id": "concurrency-channel-state",
      "name": "Channel state",
      "reservedWords": [
        "fun",
        "return",
        "end",
        "do",
        "try",
        "defer",
        "if",
        "is",
        "then"
      ],
      "sources": {
        "app.hex": [
          "fun run(h: Heap): Size | Error do",
          "    channel: Channel\u003cInt32\u003e:= try Channel\u003cInt32\u003e(h, 2)",
          "    defer channel.free(h)",
          "    capacity: Size:= channel.capacity()",
          "    before: Size:= channel.length()",
          "    channel.send(7)",
          "    during: Size:= channel.length()",
          "    channel.close()",
          "    step: Int32 | EoS:= channel.receive()",
          "    if channel.is_closed() then",
          "        if step is Int32 then",
          "            return capacity + before + during + channel.length()",
          "        end",
          "    end",
          "    return 0",
          "end"
        ]
      }
    },
    {
      "description": "Build Durations with checked units, measure a Task sleep with the monotonic clock, and read wall time.",
      "entrypoint": "app.hex",
      "features": [
        "time",
        "tasks",
        "errors"
      ],
      "id": "concurrency-time-and-sleep",
      "name": "Durations, instants, and Task sleep",
      "reservedWords": [
        "fun",
        "do",
        "end",
        "try",
        "return"
      ],
      "sources": {
        "app.hex": [
          "import",
          "    Time from \"std/time\"",
          "end",
          "fun nap(ms: UInt64): Bool do",
          "    start := Time.now()",
          "    Time.sleep(Time.milliseconds(ms))",
          "    return start.elapsed() \u003e= Time.milliseconds(ms)",
          "end",
          "fun stamp(): Int64 | Error do",
          "    now := try Time.wall_time()",
          "    return now.seconds()",
          "end",
          "budget := Time.seconds(1) + Time.milliseconds(250)",
          "print(budget.as_milliseconds(), \"\\n\")",
          "print(nap(10), \"\\n\")",
          "unix: Int64 | Error := stamp()"
        ]
      }
    }
