    {
      "id": "concurrency-mutex-critical-section",
      "name": "Mutex critical section",
      "description": "Lock and unlock a heap-backed mutex around a short operation.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun run(h: Heap): Nil | Error do",
        "    mutex: Mutex:= try Mutex.new(h)",
        "    defer mutex.free(h)",
        "    mut total: Int32:= 0",
        "    mutex.lock()",
        "    total = total + 1",
        "    mutex.unlock()",
        "    return nil",
        "end"
      ]},
      "features": ["mutex", "errors", "defer"],
      "reservedWords": ["fun", "mut", "try", "defer", "return", "nil", "end", "do"]
