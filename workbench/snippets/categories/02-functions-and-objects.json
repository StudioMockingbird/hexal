{
  "id": "functions-and-objects",
  "name": "Functions and Objects",
  "snippets": [
    {
      "id": "functions-temperature-classifier",
      "name": "Temperature classifier",
      "description": "Returns a label from a function using conditional branches.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun classify(temp: Float64): Strand do",
        "    if temp < 0.0 then",
        "        return \"cold\"",
        "    elseif temp < 20.0 then",
        "        return \"mild\"",
        "    else",
        "        return \"hot\"",
        "    end",
        "end",
        "label: Strand:= classify(15.0)"
      ]},
      "features": ["functions", "if-elseif-else"],
      "reservedWords": ["fun", "if", "elseif", "else", "return", "end", "do", "then"]
    },
    {
      "id": "functions-counter-method",
      "name": "Counter method",
      "description": "Defines a mutable receiver method that increments and returns object state.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Counter = { mut count: Int32, }",
        "impl MutPtr<Counter>.tick(): Int32 do",
        "    self.count = self.count + 1",
        "    return self.count",
        "end",
        "mut counter: Counter:= Counter { count = 0 }",
        "next: Int32:= counter.tick()"
      ]},
      "features": ["objects", "methods"],
      "reservedWords": ["type", "impl", "mut", "self", "return", "end", "do"]
    },
    {
      "id": "functions-point-translation",
      "name": "Point translation",
      "description": "Uses an object method to update two coordinates.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Point = { mut x: Int32, mut y: Int32, }",
        "impl MutPtr<Point>.translate(dx: Int32, dy: Int32) do",
        "    self.x = self.x + dx",
        "    self.y = self.y + dy",
        "end",
        "mut origin: Point:= Point { x = 0, y = 0 }",
        "origin.translate(3, -4)"
      ]},
      "features": ["objects", "methods"],
      "reservedWords": ["type", "impl", "mut", "self", "end", "do"]
    },
    {
      "id": "functions-value-pipeline",
      "name": "Function value pipeline",
      "description": "Stores a named function in a Fun value and invokes it with typed arguments.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun combine(a: Int32, b: Int32): Int32 do",
        "    return (a * 2) + b",
        "end",
        "step: Fun<(Int32, Int32) : Int32> := combine",
        "result: Int32:= step(3, 4)"
      ]},
      "features": ["functions", "function-values"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "functions-no-result-notifier",
      "name": "No-result notifier",
      "description": "Defines and calls a function without a return value.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun notify(name: Strand) do",
        "    print(\"notify \", name)",
        "end",
        "boot: Strand:= \"boot\"",
        "notify(boot)"
      ]},
      "features": ["no-result-functions", "print"],
      "reservedWords": ["fun", "end", "do"]
    },
    {
      "id": "functions-generic-identity",
      "name": "Generic identity",
      "description": "Preserves a value's type through a generic function.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun identity<T>(value: T): T do",
        "    return value",
        "end",
        "number: Int32:= identity(7)",
        "word: Strand:= \"seven\"",
        "text: Strand:= identity(word)"
      ]},
      "features": ["generics", "functions"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "functions-generic-container",
      "name": "Generic container",
      "description": "Stores and retrieves a value through a generic object.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Box<T> = { value: T, }",
        "impl Box<T>.get(): T do",
        "    return self.value",
        "end",
        "box: Box<Int32>:= Box { value = 42 }",
        "stored: Int32:= box.get()"
      ]},
      "features": ["generics", "objects"],
      "reservedWords": ["type", "impl", "self", "return", "end", "do"]
    },
    {
      "id": "functions-object-formatter",
      "name": "Object formatter",
      "description": "Passes an object to print as a structured value.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Status = { name: Strand, code: Int32, }",
        "status: Status:= Status { name = \"ok\", code = 200 }",
        "print(status)"
      ]},
      "features": ["objects", "print"],
      "reservedWords": ["type"]
    },
    {
      "id": "functions-nested-object-update",
      "name": "Nested object update",
      "description": "Mutates a field inside a nested object through a mutable binding.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Inner = { mut level: Int32, }",
        "type Outer = { mut inner: Inner, }",
        "mut outer: Outer:= Outer { inner = Inner { level = 1 } }",
        "outer.inner.level = 5"
      ]},
      "features": ["objects", "bindings"],
      "reservedWords": ["type", "mut"]
    },
    {
      "id": "functions-receiver-forms",
      "name": "Receiver forms",
      "description": "Contrasts the three impl targets: a value receiver copies, Ptr<T> reads caller storage, and MutPtr<T> writes it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Meter = { mut reading: Int32, }",
        "impl Meter.peek(): Int32 do",
        "    return self.reading",
        "end",
        "impl Ptr<Meter>.seen(): Int32 do",
        "    return self.reading",
        "end",
        "impl MutPtr<Meter>.raise() do",
        "    self.reading = self.reading + 1",
        "end",
        "mut meter: Meter:= Meter { reading = 1 }",
        "copied: Int32:= meter.peek()",
        "read: Int32:= meter.seen()",
        "meter.raise()"
      ]},
      "features": ["objects", "methods"],
      "reservedWords": ["type", "impl", "mut", "self", "return", "end", "do"]
    },
    {
      "id": "functions-stored-literal",
      "name": "Stored function literal",
      "description": "Binds an anonymous function literal to a name and calls it, exactly like the equivalent named declaration.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "square:= fun (value: Int32): Int32 do",
        "    return value * value",
        "end",
        "result: Int32:= square(6)"
      ]},
      "features": ["functions", "function-values", "anonymous-functions"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "functions-literal-passed-directly",
      "name": "Directly passed function literal",
      "description": "Passes an anonymous function literal straight into a callback parameter with no intermediate binding.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun apply(callback: Fun<(Int32) : Int32>, value: Int32): Int32 do",
        "    return callback(value)",
        "end",
        "result: Int32:= apply(fun (value: Int32): Int32 do",
        "    return value * value",
        "end, 5)"
      ]},
      "features": ["functions", "function-values", "anonymous-functions"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "functions-bound-no-result-literal",
      "name": "Bound no-result function literal",
      "description": "A no-result literal must be bound to a name before it can be invoked.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "increment:= fun (counter: MutPtr<Int32>) do",
        "    counter.value = counter.value + 1",
        "end",
        "mut total: Int32:= 0",
        "increment(ref total)"
      ]},
      "features": ["functions", "no-result-functions", "anonymous-functions"],
      "reservedWords": ["fun", "mut", "end", "do"]
    },
    {
      "id": "functions-multi-parameter-literal",
      "name": "Multi-parameter function literal",
      "description": "An anonymous function literal with more than one parameter, stored and called like any other function value.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "combine:= fun (a: Int32, b: Int32, c: Int32): Int32 do",
        "    return a + b + c",
        "end",
        "result: Int32:= combine(1, 2, 3)"
      ]},
      "features": ["functions", "function-values", "anonymous-functions"],
      "reservedWords": ["fun", "return", "end", "do"]
    }
  ]
}
