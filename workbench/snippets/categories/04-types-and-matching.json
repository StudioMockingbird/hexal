{
  "id": "types-and-matching",
  "name": "Types and Matching",
  "snippets": [
    {
      "id": "types-nullable-score",
      "name": "Nullable score",
      "description": "Narrows Int32 | Nil before reading the value.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "let score: Int32 | Nil= 42",
        "if score != nil then",
        "    let display: Int32= score",
        "end"
      ]},
      "features": ["unions", "nullability"],
      "reservedWords": ["if", "nil", "end", "then"]
    },
    {
      "id": "types-multi-type-value",
      "name": "Multi-type value",
      "description": "Distinguishes an Int32 | Bool | Nil union with is.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "let value: Int32 | Bool | Nil= true",
        "if value is Int32 then",
        "    let number: Int32= value",
        "elseif value != nil then",
        "    let flag: Bool= value",
        "else",
        "    print(value)",
        "end"
      ]},
      "features": ["unions", "if-elseif-else"],
      "reservedWords": ["if", "elseif", "else", "is", "end", "true", "nil", "then"]
    },
    {
      "id": "types-direction-match",
      "name": "Direction match",
      "description": "Converts an ADT direction into a numeric step.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Direction is North | East | South | West end",
        "let heading: Direction= Direction.East()",
        "let step: Int32= match heading is",
        "| Direction.North then 0",
        "| Direction.East then 1",
        "| Direction.South then 2",
        "| Direction.West then 3",
        "end"
      ]},
      "features": ["adts", "match"],
      "reservedWords": ["type", "match", "is", "then", "end"]
    },
    {
      "id": "types-command-dispatch",
      "name": "Command dispatch",
      "description": "Matches unit and record variants of a command type.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Command is union | Stop | Move as distance: Int32 end end",
        "let command: Command= Command.Move(distance = 4)",
        "let label: Int32= match command is",
        "| Command.Stop then 0",
        "| Command.Move then command.distance",
        "end"
      ]},
      "features": ["adts", "match"],
      "reservedWords": ["type", "union", "match", "is", "then", "end"]
    },
    {
      "id": "types-shape-area",
      "name": "Shape area",
      "description": "Matches circle and rectangle variants to calculate an area.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Shape is union | Circle as radius: Int32 end | Rect as width: Int32, height: Int32 end end",
        "let shape: Shape= Shape.Circle(radius = 2)",
        "let area: Int32= match shape is",
        "| Shape.Circle then shape.radius * shape.radius",
        "| Shape.Rect then shape.width * shape.height",
        "end"
      ]},
      "features": ["adts", "match"],
      "reservedWords": ["type", "match", "is", "then", "end"]
    },
    {
      "id": "types-optional-configuration",
      "name": "Optional configuration",
      "description": "Matches a present configuration value against nil.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "let config: Int32 | Nil= 8",
        "let level: Int32= match config is",
        "| Int32 then config",
        "| Nil then 0",
        "end"
      ]},
      "features": ["unions", "match"],
      "reservedWords": ["match", "is", "then", "end"]
    },
    {
      "id": "types-result-like-union",
      "name": "Result-like union",
      "description": "Returns either a value or Error from a function.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun lookup(key: Int32): Int32 | Error do",
        "    if key == 1 then",
        "        return 100",
        "    end",
        "    return Error(ErrorKind.Other(header = \"Lookup Error\"), \"unknown key\")",
        "end",
        "let value: Int32 | Error= lookup(1)"
      ]},
      "features": ["unions", "errors"],
      "reservedWords": ["fun", "if", "return", "end", "do", "then"]
    },
    {
      "id": "types-exhaustive-protocol",
      "name": "Exhaustive protocol",
      "description": "Matches every protocol variant explicitly.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Protocol is Ping | Pong | Quit end",
        "let frame: Protocol= Protocol.Ping()",
        "let code: Int32= match frame is",
        "| Protocol.Ping then 1",
        "| Protocol.Pong then 2",
        "| Protocol.Quit then 0",
        "end"
      ]},
      "features": ["adts", "match"],
      "reservedWords": ["type", "match", "is", "then", "end"]
    },
    {
      "id": "types-variant-payload",
      "name": "Variant payload access",
      "description": "Matches a record variant and uses its payload fields.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Event is union | Key as code: Int32 end | Move as dx: Int32, dy: Int32 end end",
        "let event: Event= Event.Move(dx = 3, dy = 4)",
        "let distance: Int32= match event is",
        "| Event.Key then event.code",
        "| Event.Move then event.dx + event.dy",
        "end"
      ]},
      "features": ["adts", "match"],
      "reservedWords": ["type", "match", "is", "then", "end"]
    },
    {
      "id": "types-type-based-formatting",
      "name": "Type-based formatting",
      "description": "Selects formatting behavior based on a union member type.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "let value: Int32 | Float64= 1",
        "let label: Strand= match value is",
        "| Int32 then \"integer\"",
        "| Float64 then \"float\"",
        "end"
      ]},
      "features": ["unions", "match"],
      "reservedWords": ["match", "is", "then", "end"]
    },
    {
      "id": "types-scalar-value-match",
      "name": "Scalar value match",
      "description": "Dispatches on an integer, a Rune, and the Eos singleton with literal arms and a required else.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun opcode_label(op: Int32): Int32 do",
        "    return match op",
        "    | 1 then 10",
        "    | 2 then 20",
        "    | else then 0",
        "    end",
        "end",
        "fun rune_label(r: Rune): Int32 do",
        "    return match r",
        "    | 'A' then 65",
        "    | else then 0",
        "    end",
        "end",
        "let marker: EoS= eos",
        "let eos_value: Int32= match marker",
        "    | eos then 7",
        "end",
        "print(opcode_label(1) + rune_label('A') + eos_value)"
      ]},
      "features": ["match", "literals"],
      "reservedWords": ["fun", "return", "end", "do", "match", "then", "else", "eos"]
    }
  ]
}
