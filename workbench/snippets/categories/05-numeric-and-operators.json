{
  "id": "numeric-and-operators",
  "name": "Numeric and Operators",
  "snippets": [
    {
      "id": "numeric-arithmetic-expression",
      "name": "Arithmetic expression",
      "description": "Combine addition, subtraction, multiplication, division, and remainder.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Int32 do",
        "    let left: Int32= 10",
        "    let right: Int32= 3",
        "    let sum: Int32= left + right",
        "    let difference: Int32= left - right",
        "    let product: Int32= left * right",
        "    let quotient: Int32= left / right",
        "    let remainder: Int32= left % right",
        "    return sum + difference + product + quotient + remainder",
        "end"
      ]},
      "features": ["arithmetic"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "numeric-precedence-check",
      "name": "Precedence check",
      "description": "Show how grouped and ungrouped expressions produce different results.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Bool do",
        "    let first: Int32= 2",
        "    let second: Int32= 3",
        "    let third: Int32= 4",
        "    let ungrouped: Int32= first + (second * third)",
        "    let grouped: Int32= (first + second) * third",
        "    return ungrouped < grouped",
        "end"
      ]},
      "features": ["arithmetic"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "numeric-range-comparison",
      "name": "Range comparison",
      "description": "Use relational decisions to classify a number.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun classify(value: Int32): String<31> do",
        "    if value < 0 then",
        "        return \"negative\"",
        "    elseif value < 10 then",
        "        return \"small\"",
        "    elseif value < 100 then",
        "        return \"medium\"",
        "    end",
        "    return \"large\"",
        "end"
      ]},
      "features": ["equality-ordering", "if-elseif-else"],
      "reservedWords": ["fun", "if", "elseif", "return", "end", "do", "then"]
    },
    {
      "id": "numeric-bit-mask-test",
      "name": "Bit mask test",
      "description": "Test and combine flag bits with &, |, and shifts.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Bool do",
        "    let flags: UInt32= 0b1010",
        "    let mask: UInt32= 0b0010",
        "    let enabled: Bool= (flags \u0026 mask) != 0",
        "    let combined: UInt32= flags | 0b0100",
        "    let shifted: UInt32= flags \u003c\u003c 2",
        "    return enabled and (combined != flags) and (shifted == 0b101000)",
        "end"
      ]},
      "features": ["bitwise"],
      "reservedWords": ["fun", "return", "end", "and", "do"]
    },
    {
      "id": "numeric-bit-flag-update",
      "name": "Bit flag update",
      "description": "Set, clear, and toggle individual flags.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): UInt8 do",
        "    let mut flags: UInt8= 0b0000",
        "    let enabled: UInt8= 0b0001",
        "    flags = flags | enabled",
        "    flags = flags & ~enabled",
        "    flags = flags ^ enabled",
        "    return flags",
        "end"
      ]},
      "features": ["bitwise"],
      "reservedWords": ["fun", "mut", "return", "end", "do"]
    },
    {
      "id": "numeric-signed-conversion",
      "name": "Signed conversion",
      "description": "Convert a wide signed integer to a narrow type explicitly.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Int32 do",
        "    let mut wide: Int64= 100",
        "    let small: Int8= wide.to\u003cInt8\u003e()",
        "    let back: Int64= small.to\u003cInt64\u003e()",
        "    return small.to<Int32>() + back.to<Int32>()",
        "end"
      ]},
      "features": ["numeric-conversions"],
      "reservedWords": ["fun", "mut", "return", "end", "do"]
    },
    {
      "id": "numeric-floating-conversion",
      "name": "Floating conversion",
      "description": "Widen an integer into a floating-point value without explicit syntax.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Float64 do",
        "    let whole: Int32= 5",
        "    let ratio: Float64= whole",
        "    let half: Float64= ratio / 2.0",
        "    return half",
        "end"
      ]},
      "features": ["lossless-widening"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "numeric-bit-cast",
      "name": "Bit cast",
      "description": "Reinterpret a UInt32 bit pattern as Float32.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Bool do",
        "    let bits: UInt32= 0x3F800000",
        "    let floating: Float32= bits.bit_cast\u003cFloat32\u003e()",
        "    let restored: UInt32= floating.bit_cast\u003cUInt32\u003e()",
        "    return restored == bits",
        "end"
      ]},
      "features": ["bit-casting"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "numeric-endian-round-trip",
      "name": "Endian round trip",
      "description": "Encode an integer as bytes and reconstruct it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Bool do",
        "    let value: UInt32= 0x01020304",
        "    let little: Array\u003cUInt8, 4\u003e = value.to_le_bytes()",
        "    let big: Array\u003cUInt8, 4\u003e = value.to_be_bytes()",
        "    let back: UInt32= UInt32.from_le_bytes(little)",
        "    let swapped: UInt32= UInt32.from_be_bytes(big)",
        "    return (back == value) and (swapped == value)",
        "end"
      ]},
      "features": ["endian-conversion"],
      "reservedWords": ["fun", "return", "end", "and", "do"]
    }
  ]
}
