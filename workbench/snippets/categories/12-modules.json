{
  "id": "modules",
  "name": "Modules",
  "snippets": [
    {
      "description": "A root module calls an exported function from a second in-memory source file.",
      "entrypoint": "app.hex",
      "features": [
        "modules",
        "exports"
      ],
      "id": "module-import-export",
      "name": "Qualified module imports",
      "reservedWords": [
        "import",
        "export",
        "fun",
        "return",
        "end",
        "do"
      ],
      "sources": {
        "app.hex": [
          "import",
          "    Math from \"./math\"",
          "end",
          "answer: Int32:= Math.add(20, 22)"
        ],
        "math.hex": [
          "fun add(left: Int32, right: Int32): Int32 do",
          "    return left + right",
          "end",
          "export",
          "    add",
          "end"
        ]
      }
    },
    {
      "description": "A module declares a fixed and a mutable static module value; an importer reads both and assigns the mutable one.",
      "entrypoint": "app.hex",
      "features": [
        "modules",
        "exports"
      ],
      "id": "static-module-values",
      "name": "Static module values",
      "reservedWords": [
        "import",
        "export",
        "static",
        "mut",
        "end"
      ],
      "sources": {
        "app.hex": [
          "import",
          "    Settings from \"./settings\"",
          "end",
          "port: Int32:= Settings.DefaultPort",
          "Settings.RequestCount = Settings.RequestCount + 1",
          "total: UInt64:= Settings.RequestCount"
        ],
        "settings.hex": [
          "static DefaultPort: Int32:= 8080",
          "static mut RequestCount: UInt64:= 0",
          "export",
          "    DefaultPort,",
          "    RequestCount",
          "end"
        ]
      }
    },
    {
      "description": "A root module imports an exported type and method from a nested directory module and uses them qualified.",
      "entrypoint": "app.hex",
      "features": [
        "modules",
        "exports",
        "methods"
      ],
      "id": "modules-nested-import",
      "name": "Nested directory imports",
      "reservedWords": [
        "import",
        "export",
        "type",
        "fun",
        "method",
        "self",
        "return",
        "end",
        "do"
      ],
      "sources": {
        "app.hex": [
          "import",
          "    Shapes from \"./graphics/shapes\"",
          "end",
          "origin: Shapes.Point := Shapes.origin()",
          "width: Int32:= origin.width()"
        ],
        "graphics/shapes.hex": [
          "type Point is struct x: Int32, y: Int32 end",
          "fun origin(): Point do",
          "    return Point(x = 10, y = 20)",
          "end",
          "method Point.width(): Int32 do",
          "    return self.x",
          "end",
          "export",
          "    Point,",
          "    origin,",
          "    Point.width",
          "end"
        ]
      }
    },
    {
