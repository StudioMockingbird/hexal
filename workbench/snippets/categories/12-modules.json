    {
      "description": "Instantiate and use List\u003cImportedType\u003e across a module boundary.",
      "entrypoint": "app.hex",
      "features": [
        "modules",
        "exports",
        "lists",
        "generics",
        "objects"
      ],
      "id": "modules-list-imported-type",
      "name": "List of an imported type",
      "reservedWords": [
        "import",
        "fun",
        "return",
        "end",
        "do",
        "export",
        "type",
        "defer"
      ],
      "sources": {
        "app.hex": [
          "import",
          "    Types from \"./types\"",
          "end",
          "fun total(h: Heap): Int32 do",
          "    points: List\u003cTypes.Point\u003e := List\u003cTypes.Point\u003e(h)",
          "    defer points.free(h)",
          "    points.push(Types.make())",
          "    point: Types.Point := points[0]",
          "    return point.x + point.y",
          "end"
        ],
        "types.hex": [
          "type Point is struct x: Int32, y: Int32 end",
          "fun make(): Point do",
          "    return Point(x = 2, y = 3)",
          "end",
          "export",
          "    Point,",
          "    make",
          "end"
        ]
      }
    },
    {
      "description": "Use an imported type as a dictionary value with qualified names.",
      "entrypoint": "app.hex",
      "features": [
        "modules",
        "exports",
        "dicts",
        "generics",
        "objects"
      ],
      "id": "modules-dict-imported-types",
      "name": "Dictionary of imported types",
      "reservedWords": [
        "import",
        "fun",
        "return",
        "end",
        "do",
        "export",
        "type",
        "defer"
      ],
      "sources": {
        "app.hex": [
          "import",
          "    Types from \"./types\"",
          "end",
          "fun lookup(h: Heap): Int32 do",
          "    scores: Dict\u003cStrand, Types.Score\u003e := Dict\u003cStrand, Types.Score\u003e(h)",
          "    defer scores.free(h)",
          "    scores.insert(\"ada\", Types.make())",
          "    score: Types.Score := scores.get(\"ada\")",
          "    return score.value",
          "end"
        ],
        "types.hex": [
          "type Score is struct value: Int32 end",
          "fun make(): Score do",
          "    return Score(value = 42)",
          "end",
          "export",
          "    Score,",
          "    make",
          "end"
        ]
      }
    },
    {
      "description": "Same-shaped types from different modules remain distinct while each can be used by its own function.",
      "entrypoint": "app.hex",
      "features": [
        "modules",
        "exports",
        "objects",
        "functions"
      ],
      "id": "modules-cross-module-nominal-types",
      "name": "Cross-module nominal identity",
      "reservedWords": [
        "import",
        "export",
        "type",
        "fun",
        "return",
        "end",
        "do"
      ],
      "sources": {
        "app.hex": [
          "import",
          "    Left from \"./left\",",
          "    Right from \"./right\"",
          "end",
          "left: Int32:= Left.measure(Left.make())",
          "right: Int32:= Right.measure(Right.make())",
          "answer: Int32:= left + right"
        ],
        "left.hex": [
          "type Point is struct value: Int32 end",
          "fun make(): Point do",
          "    return Point(value = 2)",
          "end",
          "fun measure(point: Point): Int32 do",
          "    return point.value",
          "end",
          "export",
          "    Point,",
          "    make,",
          "    measure",
          "end"
        ],
        "right.hex": [
          "type Point is struct value: Int32 end",
          "fun make(): Point do",
          "    return Point(value = 3)",
          "end",
          "fun measure(point: Point): Int32 do",
          "    return point.value * 10",
          "end",
          "export",
          "    Point,",
          "    make,",
          "    measure",
          "end"
        ]
      }
    },
