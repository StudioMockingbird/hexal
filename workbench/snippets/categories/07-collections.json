    {
      "id": "collections-array-statistics",
      "name": "Array statistics",
      "description": "Calculate minimum, maximum, and total over a fixed array; the total is computed by a spawned task.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun total_of(fixed: Array<Int32, 3>): Int32",
        "    mut total: Int32 = 0",
        "    for value in fixed do",
        "        total = total + value",
        "    end",
        "    return total",
        "end",
        "fun run(): Int32 | Error",
        "    fixed: Array<Int32, 3> = [7, 3, 9]",
        "    mut minimum: Int32 = fixed[0]",
        "    mut maximum: Int32 = minimum",
        "    for value in fixed do",
        "        if value < minimum minimum = value end",
        "        if value > maximum maximum = value end",
        "    end",
        "    worker: Task<Int32> = try spawn total_of(fixed)",
        "    return worker.join() + minimum + maximum",
        "end"
      ]},
      "features": ["arrays", "for", "tasks"],
      "reservedWords": ["fun", "mut", "for", "in", "do", "if", "return", "end", "try", "spawn"]
    },
    {
      "id": "collections-array-slicing",
      "name": "Array slicing",
      "description": "Create a view over the middle of an array.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Int32",
        "    fixed: Array<Int32, 5> = [10, 20, 30, 40, 50]",
        "    middle: View<Int32> = fixed.slice(1, 4)",
        "    count: Size = middle.length()",
        "    first: Int32 = middle[0]",
        "    last: Int32 = middle.at(2)",
        "    return first + last",
        "end"
      ]},
      "features": ["arrays", "views"],
      "reservedWords": ["fun", "return", "end"]
    },
    {
      "id": "collections-view-summation",
      "name": "View summation",
      "description": "Sum values through indexed and checked view access.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun sum_positive(values: View<Int32>): Int32",
        "    mut total: Int32 = 0",
        "    for i, value in values do",
        "        if value <= 0",
        "            continue",
        "        end",
        "        total = total + value + values[i]",
        "    end",
        "    return total",
        "end",
        "fun demo(): Int32",
        "    fixed: Array<Int32, 4> = [3, -1, 5, -2]",
        "    return sum_positive(fixed.slice(0, 4))",
        "end"
      ]},
      "features": ["views", "for"],
      "reservedWords": ["fun", "mut", "for", "in", "do", "if", "continue", "return", "end"]
    },
    {
      "id": "collections-list-builder",
      "name": "List builder",
      "description": "Push several values into a heap-backed list and read them.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun build_values(h: Heap): List<Int32>",
        "    values: List<Int32> = List<Int32>.new(h)",
        "    values.push(3)",
        "    values.push(6)",
        "    values.push(9)",
        "    return values",
        "end",
        "fun demo(h: Heap): Int32",
        "    values: List<Int32> = build_values(h)",
        "    defer values.free(h)",
        "    first: Int32 = values.at(0)",
        "    last: Int32 = values[2]",
        "    return first + last",
        "end"
      ]},
      "features": ["lists", "functions"],
      "reservedWords": ["fun", "return", "end", "defer"]
    },
    {
      "id": "collections-list-stack",
      "name": "List stack",
      "description": "Use push and pop to model a small stack, guarding each pop.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun pop_safe(values: List<Int32>): Int32 | Error",
        "    if values.is_empty()",
        "        return Error.new(\"catalog\", \"stack underflow\")",
        "    end",
        "    return values.pop()",
        "end",
        "fun demo(h: Heap): Int32 | Error",
        "    values: List<Int32> = List<Int32>.new(h)",
        "    defer values.free(h)",
        "    values.push(1)",
        "    values.push(2)",
        "    total: Int32 = try pop_safe(values) + try pop_safe(values)",
        "    return total",
        "end"
      ]},
      "features": ["lists", "errors", "try-errdefer"],
      "reservedWords": ["fun", "if", "return", "end", "defer", "try"]
    },
    {
      "id": "collections-dictionary-lookup",
      "name": "Dictionary lookup",
      "description": "Insert scores and retrieve a value by key, guarding with contains.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun find_score(scores: Dict<Int32, Int32>, key: Int32): Int32",
        "    if scores.contains(key)",
        "        return scores.get(key)",
        "    end",
        "    return 0",
        "end",
        "fun demo(h: Heap): Int32",
        "    scores: Dict<Int32, Int32> = Dict<Int32, Int32>.new(h)",
        "    defer scores.free(h)",
        "    scores.insert(1, 90)",
        "    scores.insert(2, 75)",
        "    alice: Int32 = find_score(scores, 1)",
        "    missing: Int32 = find_score(scores, 9)",
        "    return alice + missing",
        "end"
      ]},
      "features": ["dicts", "functions"],
      "reservedWords": ["fun", "if", "return", "end", "defer"]
    },
    {
      "id": "collections-frequency-table",
      "name": "Frequency table",
      "description": "Count repeated integer values with a dictionary.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32",
        "    counts: Dict<Int32, Int32> = Dict<Int32, Int32>.new(h)",
        "    defer counts.free(h)",
        "    samples: Array<Int32, 6> = [2, 1, 2, 3, 1, 2]",
        "    for value in samples do",
        "        if counts.contains(value)",
        "            counts.insert(value, counts.get(value) + 1)",
        "        else",
        "            counts.insert(value, 1)",
        "        end",
        "    end",
        "    return counts.get(2)",
        "end"
      ]},
      "features": ["dicts", "arrays", "for"],
      "reservedWords": ["fun", "for", "in", "do", "if", "else", "return", "end", "defer"]
    },
    {
      "id": "collections-handle-elements",
      "name": "Handle elements",
      "description": "Store String handles in an Array and a List; insertion copies the handle, not the allocation.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): String",
        "    texts: Array<String, 2> = [\"alice\", \"bob\"]",
        "    names: List<String> = List<String>.new(h)",
        "    defer names.free(h)",
        "    names.push(texts[0])",
        "    runtime: String = \"carol\".to_string(h)",
        "    names.push(runtime)",
        "    first: String = names.at(0)",
        "    runtime.free(h)",
        "    return first",
        "end"
      ]},
      "features": ["lists", "arrays", "text", "copying"],
      "reservedWords": ["fun", "return", "end", "defer"]
    },
    {
      "id": "collections-element-cleanup",
      "name": "Element cleanup",
      "description": "Free each distinct element allocation exactly once before freeing the container, and show why the container never frees its elements.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32",
        "    names: List<String> = List<String>.new(h)",
        "    defer names.free(h)",
        "    first: String = \"alpha\".to_string(h)",
        "    second: String = \"beta\".to_string(h)",
        "    third: String = \"gamma\".to_string(h)",
        "    names.push(first)",
        "    names.push(second)",
        "    names.push(third)",
        "    popped: String = names.pop()",
        "    popped.free(h)",
        "    names.clear()",
        "    second.free(h)",
        "    first.free(h)",
        "    return names.length().to<Int32>()",
        "end"
      ]},
      "features": ["lists", "text", "copying", "defer"],
      "reservedWords": ["fun", "return", "end", "defer"]
    },
    {
      "id": "collections-nested-list",
      "name": "Nested list",
      "description": "Build a List<List<Int32>> and read through both levels.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32",
        "    rows: List<List<Int32>> = List<List<Int32>>.new(h)",
        "    defer rows.free(h)",
        "    first: List<Int32> = List<Int32>.new(h)",
        "    defer first.free(h)",
        "    first.push(1)",
        "    first.push(2)",
        "    rows.push(first)",
        "    second: List<Int32> = List<Int32>.new(h)",
        "    defer second.free(h)",
        "    second.push(3)",
        "    rows.push(second)",
        "    mut total: Int32 = 0",
        "    for row in rows do",
        "        for value in row do",
        "            total = total + value",
        "        end",
        "    end",
        "    return total",
        "end"
      ]},
      "features": ["lists", "for"],
      "reservedWords": ["fun", "for", "in", "do", "return", "end", "defer", "mut"]
    }
