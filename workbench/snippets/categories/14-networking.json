        "text"
      ],
      "id": "networking-address-parse-format",
      "name": "Parse and format an address",
      "reservedWords": [
        "fun",
        "do",
        "end",
        "try",
        "return",
        "nil"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Net from std.net",
          "end",
          "fun describe(h: Heap): Nil | Error do",
          "    let v4: Net.Address = try Net.parse_address(\"127.0.0.1\", 8080)",
          "    let v6: Net.Address = try Net.parse_address(\"::1\", 8080)",
          "    let host4: String = v4.format(h)",
          "    let host6: String = v6.format(h)",
          "    return nil",
          "end",
          "let described: Nil | Error = describe(Heap())"
        ]
      }
    },
    {
      "description": "Listen on a loopback address, accept one connection on a spawned Task, and echo one write back to the connecting client.",
      "entrypoint": "app.hex",
      "features": [
        "networking",
        "errors",
        "try-errdefer",
        "tasks-and-concurrency",
        "collections"
      ],
      "id": "networking-tcp-echo",
      "name": "TCP loopback echo",
      "reservedWords": [
        "fun",
        "do",
        "end",
        "try",
        "defer",
        "return",
        "nil",
        "if",
        "is",
        "then",
        "match"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Net from std.net",
          "end",
          "fun serve(listener: Net.TcpListener): Nil | Error do",
          "    let connection: Net.TcpConnection = try listener.accept()",
          "    defer connection.close()",
          "    let buffer: List\u003cByte\u003e = List\u003cByte\u003e(Heap())",
          "    defer buffer.free(Heap())",
          "    let received: Size | EoS = try connection.read(buffer, 64)",
          "    if received is Size then",
          "        try connection.write(buffer.slice(0, received))",
          "    end",
          "    return nil",
          "end",
          "fun run(address: Net.Address): Nil | Error do",
          "    let listener: Net.TcpListener = try Net.listen(address, 4)",
          "    defer listener.close()",
          "    let task: Task\u003cNil | Error\u003e = try spawn serve(listener)",
          "    let connection: Net.TcpConnection = try Net.connect(address)",
          "    defer connection.close()",
          "    let ping_text: String = \"ping\"",
          "    try connection.write(ping_text.bytes())",
          "    task.join()",
          "    return nil",
          "end",
          "let address: Net.Address | Error = Net.parse_address(\"127.0.0.1\", 18735)",
          "let started: Nil | Error = match address is",
          "| Net.Address then run(address)",
          "| Error then nil",
          "end"
        ]
      }
    },
    {
      "description": "Serve routes with shared state over HTTP: a router, an application context reached through Ptr, a listening server run on its own Task, and a loopback client that reads one response before the server stops.",
      "entrypoint": "app.hex",
      "features": [
        "networking",
        "errors",
        "try-errdefer",
        "tasks-and-concurrency",
        "atomics",
        "defer"
      ],
      "id": "networking-http-server",
      "name": "HTTP server with shared state",
      "reservedWords": [
        "import",
        "type",
        "struct",
        "fun",
        "do",
        "end",
        "let",
        "mut",
        "try",
        "defer",
        "return",
        "nil",
        "if",
        "is",
        "then",
        "while",
        "spawn"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Http from std.http,",
          "   Net from std.net",
          "end",
          "",
          "type App is struct",
          "    hits: Atomic\u003cInt32\u003e",
          "end",
          "",
          "fun hello(app: Ptr\u003cApp\u003e, request: Http.Request, response: Http.Writer): Nil | Error do",
          "    let seen = (^app).hits.fetch_add(1) + 1",
          "    let text = String.interpolate(Heap(), \"visit {{ seen }}\\n\")",
          "    defer text.free(Heap())",
          "    try response.content_length(text.length())",
          "    try response.write(text.bytes())",
          "    return nil",
          "end",
          "",
          "fun serve(server: Http.Server\u003cApp\u003e): Nil | Error do",
          "    return server.run()",
          "end",
          "",
          "fun fetch(address: Net.Address): Nil | Error do",
          "    let connection = try Net.connect(address)",
          "    defer connection.close()",
          "    let request: String = \"GET / HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n\"",
          "    try connection.write(request.bytes())",
          "    let reply: List\u003cByte\u003e = List\u003cByte\u003e(Heap())",
          "    defer reply.free(Heap())",
          "    let mut open = true",
          "    while open do",
          "        let step = try connection.read(reply, 256)",
          "        if step is EoS then",
          "            open = false",
          "        end",
          "    end",
          "    let text = try reply.slice(0, reply.length()).to\u003cString\u003e(Heap())",
          "    defer text.free(Heap())",
          "    print(text)",
          "    return nil",
          "end",
          "",
          "fun run(): Nil | Error do",
          "    let heap = Heap()",
          "    let app = App(hits = Atomic\u003cInt32\u003e(0))",
          "    let mut router = Http.Router\u003cApp\u003e(heap)",
          "    defer router.free(heap)",
          "    try router.route(\"GET\", \"/\", hello)",
          "    let server = try Http.listen\u003cApp\u003e(heap, Http.default_config(\"127.0.0.1\", 18080), router, @app)",
          "    defer server.free(heap)",
          "    let serving = try spawn serve(server)",
          "    let address = try Net.parse_address(\"127.0.0.1\", 18080)",
          "    try fetch(address)",
          "    server.stop()",
          "    try serving.join()",
          "    return nil",
          "end",
          "",
          "let outcome = run()"
        ]
      }
    },
    {
      "description": "Serve a directory over HTTP: a FileServer rooted at a retained directory handle, mounted under a path prefix, answering a missing file and a traversal attempt with 404 and 403 and never exposing a physical path.",
      "entrypoint": "app.hex",
      "features": [
        "networking",
        "errors",
        "try-errdefer",
        "tasks-and-concurrency",
        "atomics",
        "defer"
      ],
      "id": "networking-file-server",
      "name": "Static file server with a mounted directory",
      "reservedWords": [
        "import",
        "type",
        "struct",
        "fun",
        "do",
        "end",
        "let",
        "mut",
        "try",
        "defer",
        "return",
        "nil",
        "if",
        "is",
        "then",
        "while",
        "spawn"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Http from std.http,",
          "   Net from std.net",
          "end",
          "",
          "type Site is struct",
          "    hits: Atomic\u003cInt32\u003e",
          "end",
          "",
          "fun serve(server: Http.Server\u003cSite\u003e): Nil | Error do",
          "    return server.run()",
          "end",
          "",
          "fun fetch(address: Net.Address, target: String): Nil | Error do",
          "    let connection = try Net.connect(address)",
          "    defer connection.close()",
          "    let request = String.interpolate(Heap(), \"GET {{ target }} HTTP/1.1\\r\\nHost: localhost\\r\\nConnection: close\\r\\n\\r\\n\")",
          "    defer request.free(Heap())",
          "    try connection.write(request.bytes())",
          "    let reply: List\u003cByte\u003e = List\u003cByte\u003e(Heap())",
          "    defer reply.free(Heap())",
          "    let mut open = true",
          "    while open do",
          "        let step = try connection.read(reply, 256)",
          "        if step is EoS then",
          "            open = false",
          "        end",
          "    end",
          "    let text = try reply.slice(0, reply.length()).to\u003cString\u003e(Heap())",
          "    defer text.free(Heap())",
          "    print(target, \"\\n\", text, \"\\n\")",
          "    return nil",
          "end",
          "",
          "fun run(): Nil | Error do",
          "    let heap = Heap()",
          "    let site = Site(hits = Atomic\u003cInt32\u003e(0))",
          "    let files = try Http.FileServer(heap, \".\", \"index.html\", false, \"no-cache\")",
          "    defer files.free(heap)",
          "    let mut router = Http.Router\u003cSite\u003e(heap)",
          "    defer router.free(heap)",
          "    try router.mount(\"/static\", files)",
          "    let server = try Http.listen\u003cSite\u003e(heap, Http.default_config(\"127.0.0.1\", 18081), router, @site)",
          "    defer server.free(heap)",
          "    let serving = try spawn serve(server)",
          "    let address = try Net.parse_address(\"127.0.0.1\", 18081)",
          "    try fetch(address, \"/static/absent.txt\")",
          "    try fetch(address, \"/static/../secret.txt\")",
          "    server.stop()",
          "    try serving.join()",
          "    return nil",
          "end",
          "",
          "let outcome = run()"
        ]
      }
    }
  ]
