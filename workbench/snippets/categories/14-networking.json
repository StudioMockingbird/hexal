{
  "id": "networking",
  "name": "Networking",
  "snippets": [
    {
      "description": "Parse a numeric IPv4 and IPv6 literal and format each back to its host text.",
      "entrypoint": "app.hex",
      "features": [
        "networking",
        "errors",
        "text"
      ],
      "id": "networking-address-parse-format",
      "name": "Parse and format an address",
      "reservedWords": [
        "fun",
        "do",
        "end",
        "try",
        "return",
        "nil"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Net from std.net",
          "end",
          "fun describe(h: Heap): Nil | Error do",
          "    v4: Net.Address := try Net.parse_address(\"127.0.0.1\", 8080)",
          "    v6: Net.Address := try Net.parse_address(\"::1\", 8080)",
          "    host4: String := v4.format(h)",
          "    host6: String := v6.format(h)",
          "    return nil",
          "end",
          "described: Nil | Error := describe(Heap())"
        ]
      }
    },
    {
      "description": "Listen on a loopback address, accept one connection on a spawned Task, and echo one write back to the connecting client.",
      "entrypoint": "app.hex",
      "features": [
        "networking",
        "errors",
        "try-errdefer",
        "tasks-and-concurrency",
        "collections"
      ],
      "id": "networking-tcp-echo",
      "name": "TCP loopback echo",
      "reservedWords": [
        "fun",
        "do",
        "end",
        "try",
        "defer",
        "return",
        "nil",
        "if",
        "is",
        "then",
        "match"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Net from std.net",
          "end",
          "fun serve(listener: Net.TcpListener): Nil | Error do",
          "    connection: Net.TcpConnection := try listener.accept()",
          "    defer connection.close()",
          "    buffer: List\u003cByte\u003e := List\u003cByte\u003e(Heap())",
          "    defer buffer.free(Heap())",
          "    received: Size | EoS := try connection.read(buffer, 64)",
          "    if received is Size then",
          "        try connection.write(buffer.slice(0, received))",
          "    end",
          "    return nil",
          "end",
          "fun run(address: Net.Address): Nil | Error do",
          "    listener: Net.TcpListener := try Net.listen(address, 4)",
          "    defer listener.close()",
          "    task: Task\u003cNil | Error\u003e := try spawn serve(listener)",
          "    connection: Net.TcpConnection := try Net.connect(address)",
          "    defer connection.close()",
          "    try connection.write(\"ping\".bytes())",
          "    task.join()",
          "    return nil",
          "end",
          "address: Net.Address | Error := Net.parse_address(\"127.0.0.1\", 18735)",
          "started: Nil | Error := match address is",
          "| Net.Address then run(address)",
          "| Error then nil",
          "end"
        ]
      }
    }
  ]
}
