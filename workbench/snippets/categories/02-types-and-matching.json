{
  "id": "types-and-matching",
  "name": "Types and Matching",
  "snippets": [
    {
      "id": "structural-unions",
      "name": "Structural unions",
      "description": "A nullable value narrows before use.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "value: Int32 | Bool | Nil = true",
        "mut label: Int32 = 0",
        "if value == nil",
        "    print(nil)",
        "elseif value is Bool",
        "    label = 1",
        "else",
        "    label = value",
        "end"
      ]},
      "features": ["unions", "if-elseif-else"],
      "reservedWords": ["true", "nil", "mut", "if", "is", "elseif", "else", "end"]
    },
    {
      "id": "algebraic-data-types",
      "name": "Algebraic data types",
      "description": "Unit and record variants model a small command protocol.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Command = | Stop | Move as { x: Int32, y: Int32 }",
        "command: Command = Command.Move { x = 3, y = 4 }"
      ]},
      "features": ["adts"],
      "reservedWords": ["type", "as"]
    },
    {
      "id": "match-expression",
      "name": "Match expressions",
      "description": "An exhaustive match translates an ADT into a value.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Direction = | North | South",
        "direction: Direction = Direction.North",
        "step: Int32 = match direction is",
        "| Direction.North then 1",
        "| Direction.South then -1",
        "| else then 0",
        "end"
      ]},
      "features": ["match"],
      "reservedWords": ["type", "match", "is", "then", "else", "end"]
    },
    {
      "id": "numeric-conversions",
      "name": "Explicit numeric conversions",
      "description": "Narrowing and cross-family conversions stay explicit.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "wide: Int64 = 120",
        "small: Int8 = wide.to<Int8>()",
        "precise: Float64 = small",
        "count: Size = small.to<Size>()",
        "codepoint: Rune = (65).to<Rune>()"
      ]},
      "features": ["lossless-widening", "numeric-conversions"]
    },
    {
      "id": "operators",
      "name": "Arithmetic, bitwise, and truthiness",
      "description": "Core operators compose under the fixed precedence rules.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "left: Int32 = 7",
        "right: Int32 = 3",
        "arithmetic: Int32 = (left + right) * 2 - left / right + left % right",
        "bits: UInt32 = (0xF0 & 0xCC) | (0x01 << 4) ^ 0x02",
        "ordered: Bool = left > right and arithmetic != 0",
        "fallback: Bool = ordered or false"
      ]},
      "features": ["arithmetic", "bitwise", "equality-ordering", "truthiness"],
      "reservedWords": ["and", "or", "false"]
    }
  ]
}
