{
  "id": "low-level",
  "name": "Low-level Operations",
  "snippets": [
    {
      "id": "bit-representation",
      "name": "Bit casts and byte order",
      "description": "Explicit representation operations reinterpret equal-width bits and encode integers.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "bits: UInt32 = 0x3F800000",
        "value: Float32 = bits.bit_cast<Float32>()",
        "network: Array<Byte, 4> = bits.to_be_bytes()",
        "restored: UInt32 = UInt32.from_be_bytes(network)"
      ]},
      "features": ["bit-casting", "endian-conversion"]
    },
    {
      "id": "layout-queries",
      "name": "Layout queries",
      "description": "Compile-time size and alignment queries lower to C23 layout expressions.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Pair = { left: Int32, right: Float64, }",
        "fun storage(): Size",
        "    return size_of<Pair>() + align_of<Pair>()",
        "end"
      ]},
      "features": ["layout"],
      "reservedWords": ["type", "fun", "return", "end"]
    },
    {
      "id": "volatile-access",
      "name": "Volatile access",
      "description": "Integer pointers expose explicit volatile reads and writes.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun register_demo(register: MutPtr<UInt32>): UInt32",
        "    register.write_volatile(0x10)",
        "    return register.read_volatile()",
        "end"
      ]},
      "features": ["volatile"],
      "reservedWords": ["fun", "return", "end"]
    },
    {
      "id": "unknown-pointer",
      "name": "Opaque Unknown pointers",
      "description": "A data pointer erases to Unknown and recovers its concrete pointee type.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut value: Int32 = 42",
        "opaque: MutPtr<Unknown> = ref value",
        "restored: MutPtr<Int32> = opaque",
        "answer: Int32 = restored.value"
      ]},
      "features": ["unknown-pointers"],
      "reservedWords": ["mut", "ref"]
    }
  ]
}
