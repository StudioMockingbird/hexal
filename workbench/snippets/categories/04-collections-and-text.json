{
  "id": "collections-and-text",
  "name": "Collections and Text",
  "snippets": [
    {
      "id": "arrays-views",
      "name": "Arrays and Views",
      "description": "A fixed Array exposes a zero-copy read-only slice.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut values: Array<Int32, 4> = [10, 20, 30, 40]",
        "values[1] = 25",
        "middle: View<Int32> = values.slice(1, 3)",
        "total: Int32 = middle[0] + middle.at(1)"
      ]},
      "features": ["arrays", "views"],
      "reservedWords": ["mut"]
    },
    {
      "id": "view-pointer-bridge",
      "name": "Pointer-to-View bridge",
      "description": "A foreign-style pointer and length become a bounded View.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun first(data: Ptr<Int32>, count: Size): Int32",
        "    items: View<Int32> = View<Int32>.from_pointer(data, count)",
        "    return items[0]",
        "end"
      ]},
      "features": ["view-pointer-bridge"],
      "reservedWords": ["fun", "return", "end"]
    },
    {
      "id": "lists",
      "name": "Lists",
      "description": "A growable List is populated, read, and explicitly released.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun list_total(heap: Heap): Int32",
        "    values: List<Int32> = List<Int32>.new(heap)",
        "    defer values.free(heap)",
        "    values.push(10)",
        "    values.push(20)",
        "    return values[0] + values.pop()",
        "end"
      ]},
      "features": ["lists"],
      "reservedWords": ["fun", "defer", "return", "end"]
    },
    {
      "id": "dictionaries",
      "name": "Dictionaries",
      "description": "A Dict associates integer identifiers with scores.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun lookup(heap: Heap): Int32",
        "    scores: Dict<Int32, Int32> = Dict<Int32, Int32>.new(heap)",
        "    defer scores.free(heap)",
        "    scores.insert(7, 99)",
        "    if scores.contains(7)",
        "        return scores.get(7)",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["dicts"],
      "reservedWords": ["fun", "defer", "if", "return", "end"]
    },
    {
      "id": "text-values",
      "name": "String, Strand, Byte, and Rune",
      "description": "Text values expose rune indexing and byte Views explicitly.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "label: Strand = \"Hexal\"",
        "message: String = \"Hello, λ\"",
        "first: Rune = message[0]",
        "raw: View<Byte> = message.bytes()",
        "leading: Byte = raw[0]",
        "cursor: RuneCursor = message.rune_cursor()",
        "has_more: Bool = cursor.has_next()"
      ]},
      "features": ["text"]
    },
    {
      "id": "streams",
      "name": "Lazy streams and EoS",
      "description": "A stream is consumed one step at a time until EoS.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun inspect(): Bool",
        "    stream: Stream<Int32> = Stream<Int32>.new()",
        "    complete: EoS = eos",
        "    step: Int32 | EoS = stream.next()",
        "    if step is EoS",
        "        print(\"stream complete\")",
        "        return complete == complete",
        "    end",
        "    return false",
        "end"
      ]},
      "features": ["streams"],
      "reservedWords": ["fun", "if", "is", "eos", "end"]
    }
  ]
}
