{
  "id": "errors-and-cleanup",
  "name": "Errors and Cleanup",
  "snippets": [
    {
      "id": "errors-validation-error",
      "name": "Validation error",
      "description": "Return Int32 | Error when an input is invalid, and inspect the union at the call site.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun validate(score: Int32): Int32 | Error do",
        "    if score < 0 or score > 100 then",
        "        return Error.new(\"Validation Error\", \"score out of range\")",
        "    end",
        "    return score",
        "end",
        "fun demo(): Int32 do",
        "    check: Int32 | Error = validate(150)",
        "    if check is Int32 then",
        "        return check",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["errors", "unions"],
      "reservedWords": ["fun", "if", "or", "return", "end", "is", "do", "then"]
    },
    {
      "id": "errors-propagating-read",
      "name": "Propagating read",
      "description": "Use try to propagate a failure through two sequential operations.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun read_score(): Int32 | Error do",
        "    return Error.new(\"Read Error\", \"no score\")",
        "end",
        "fun load_total(): Int32 | Error do",
        "    first: Int32 = try read_score()",
        "    second: Int32 = try read_score()",
        "    return first + second",
        "end"
      ]},
      "features": ["errors", "try-errdefer"],
      "reservedWords": ["fun", "return", "end", "try", "do"]
    },
    {
      "id": "errors-success-cleanup",
      "name": "Success cleanup",
      "description": "Use defer to release a resource on every return path.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun release(value: Int32) do",
        "end",
        "fun load(valid: Bool): Int32 do",
        "    defer release(1)",
        "    if valid then",
        "        return 10",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["defer"],
      "reservedWords": ["fun", "defer", "if", "return", "end", "do", "then"]
    },
    {
      "id": "errors-failure-cleanup",
      "name": "Failure cleanup",
      "description": "Use errdefer so cleanup runs only on an Error exit and is discarded on success.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun rollback() do",
        "end",
        "fun apply(value: Int32): Int32 | Error do",
        "    errdefer rollback()",
        "    if value < 0 then",
        "        return Error.new(\"Apply Error\", \"negative\")",
        "    end",
        "    return value",
        "end"
      ]},
      "features": ["errors", "try-errdefer"],
      "reservedWords": ["fun", "errdefer", "if", "return", "end", "do", "then"]
    },
    {
      "id": "errors-defer-order",
      "name": "Cleanup order",
      "description": "Register several deferred actions and show they run in reverse registration order.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Tracer = { mut log: Int32, }",
        "fun trace(tracer: MutPtr<Tracer>, step: Int32) do",
        "    tracer.log = tracer.log * 10 + step",
        "end",
        "fun demo(): Int32 do",
        "    mut tracer: Tracer = Tracer { log = 0 }",
        "    defer trace(ref tracer, 1)",
        "    defer trace(ref tracer, 2)",
        "    defer trace(ref tracer, 3)",
        "    return tracer.log",
        "end"
      ]},
      "features": ["defer", "objects", "pointers"],
      "reservedWords": ["type", "mut", "fun", "defer", "ref", "return", "end", "do"]
    },
    {
      "id": "errors-cleanup-helper",
      "name": "Cleanup helper",
      "description": "Keep resource cleanup in a dedicated no-result function.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun release(heap: Heap, values: List<Int32>) do",
        "    values.free(heap)",
        "end",
        "fun load(): Int32 do",
        "    h: Heap = Heap.new()",
        "    numbers: List<Int32> = List<Int32>.new(h)",
        "    defer release(h, numbers)",
        "    numbers.push(7)",
        "    return numbers.length().to<Int32>()",
        "end"
      ]},
      "features": ["defer", "lists", "no-result-functions"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    }
  ]
}
