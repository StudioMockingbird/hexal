        "    return 1",
        "end",
        "fun handle(): Int32 | Error do",
        "    let value: Int32 | Float32 = try fetch()",
        "    if value is Int32 then",
        "        return value",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["errors", "try-errdefer", "unions"],
      "reservedWords": ["fun", "return", "end", "do", "try", "is", "if", "then"]
    },
    {
      "id": "errors-try-statement-payload",
