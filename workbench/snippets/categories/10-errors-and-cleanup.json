    {
      "id": "errors-try-unwinds-through-cleanup",
      "name": "Try unwinds through cleanup",
      "description": "Propagating try runs both errdefer and defer in reverse order on the Error path.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun cleanup(value: Int32) do",
