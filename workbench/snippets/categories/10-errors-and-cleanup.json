{
  "id": "errors-and-cleanup",
  "name": "Errors and Cleanup",
  "snippets": [
    {
      "id": "errors-validation-error",
      "name": "Validation error",
      "description": "Return Int32 | Error when an input is invalid, and inspect the union at the call site.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun validate(score: Int32): Int32 | Error do",
        "    if (score < 0) or (score > 100) then",
        "        return Error(ErrorKind.Other(header = \"Validation Error\"), \"score out of range\")",
        "    end",
        "    return score",
        "end",
        "fun demo(): Int32 do",
        "    let check: Int32 | Error= validate(150)",
        "    if check is Int32 then",
        "        return check",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["errors", "unions"],
      "reservedWords": ["fun", "if", "or", "return", "end", "is", "do", "then"]
    },
    {
      "id": "errors-propagating-read",
      "name": "Propagating read",
      "description": "Use try to propagate a failure through two sequential operations.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun read_score(): Int32 | Error do",
        "    return Error(ErrorKind.Other(header = \"Read Error\"), \"no score\")",
        "end",
        "fun load_total(): Int32 | Error do",
        "    let first: Int32= try read_score()",
        "    let second: Int32= try read_score()",
        "    return first + second",
        "end"
      ]},
      "features": ["errors", "try-errdefer"],
      "reservedWords": ["fun", "return", "end", "try", "do"]
    },
    {
      "id": "errors-success-cleanup",
      "name": "Success cleanup",
      "description": "Use defer to release a resource on every return path.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun release(value: Int32) do",
        "end",
        "fun load(valid: Bool): Int32 do",
        "    defer release(1)",
        "    if valid then",
        "        return 10",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["defer"],
      "reservedWords": ["fun", "defer", "if", "return", "end", "do", "then"]
    },
    {
      "id": "errors-failure-cleanup",
      "name": "Failure cleanup",
      "description": "Use errdefer so cleanup runs only on an Error exit and is discarded on success.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun rollback() do",
        "end",
        "fun apply(value: Int32): Int32 | Error do",
        "    errdefer rollback()",
        "    if value < 0 then",
        "        return Error(ErrorKind.Other(header = \"Apply Error\"), \"negative\")",
        "    end",
        "    return value",
        "end"
      ]},
      "features": ["errors", "try-errdefer"],
      "reservedWords": ["fun", "errdefer", "if", "return", "end", "do", "then"]
    },
    {
      "id": "errors-defer-order",
      "name": "Cleanup order",
      "description": "Register several deferred actions and show they run in reverse registration order.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Tracer is struct mut log: Int32 end",
        "fun trace(tracer: Ptr<mut Tracer>, step: Int32) do",
        "    tracer.log = (tracer.log * 10) + step",
        "end",
        "fun demo(): Int32 do",
        "    let mut tracer: Tracer= Tracer(log = 0)",
        "    defer trace(@tracer, 1)",
        "    defer trace(@tracer, 2)",
        "    defer trace(@tracer, 3)",
        "    return tracer.log",
        "end"
      ]},
      "features": ["defer", "objects", "pointers"],
      "reservedWords": ["type", "mut", "fun", "defer", "@", "return", "end", "do"]
    },
    {
      "id": "errors-cleanup-helper",
      "name": "Cleanup helper",
      "description": "Keep resource cleanup in a dedicated no-result function.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun release(heap: Heap, values: List<Int32>) do",
        "    values.free(heap)",
        "end",
        "fun load(): Int32 do",
        "    let h: Heap= Heap()",
        "    let numbers: List\u003cInt32\u003e = List\u003cInt32\u003e(h)",
        "    defer release(h, numbers)",
        "    numbers.push(7)",
        "    return numbers.length().to<Int32>()",
        "end"
      ]},
      "features": ["defer", "lists", "no-result-functions"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    },
    {
      "id": "errors-nested-try-block",
      "name": "Nested-block try",
      "description": "Propagate a fallible result from inside a conditional block exactly once.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun read_value(): Int32 | Error do",
        "    return 7",
        "end",
        "fun load(): Int32 | Error do",
        "    if true then",
        "        let value: Int32= try read_value()",
        "        return value + 1",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["errors", "try-errdefer", "if-elseif-else"],
      "reservedWords": ["fun", "return", "end", "do", "if", "then", "try"]
    },
    {
      "id": "errors-try-expression",
      "name": "Try expression",
      "description": "Preserve and use the successful value produced by a try expression.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun read_value(): Int32 | Error do",
        "    return 20",
        "end",
        "fun load(): Int32 | Error do",
        "    let value: Int32= try read_value()",
        "    return value * 2",
        "end"
      ]},
      "features": ["errors", "try-errdefer", "functions"],
      "reservedWords": ["fun", "return", "end", "do", "try"]
    },
    {
      "id": "errors-try-spawn-in-loop",
      "name": "Try spawn in a loop",
      "description": "Spawn fallible tasks from inside a for loop and join each result.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun square(value: Int32): Int32 do",
        "    return value * value",
        "end",
        "fun total(): Int32 | Error do",
        "    let values: Array\u003cInt32, 3\u003e = [2, 3, 4]",
        "    let mut total: Int32= 0",
        "    for value in values do",
        "        let task: Task\u003cInt32\u003e = try spawn square(value)",
        "        total = total + task.join()",
        "    end",
        "    return total",
        "end"
      ]},
      "features": ["errors", "try-errdefer", "tasks", "for", "arrays"],
      "reservedWords": ["fun", "return", "end", "do", "for", "in", "mut", "try", "spawn"]
    },
    {
      "id": "errors-error-construction",
      "name": "Error construction",
      "description": "Construct an Error with Error.new and inspect its header() and message fields.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun fail(): Int32 | Error do",
        "    return Error(ErrorKind.Other(header = \"Input Error\"), \"missing value\")",
        "end",
        "fun inspect(): Bool do",
        "    let err: Error= Error(ErrorKind.Other(header = \"Input Error\"), \"missing value\")",
        "    return (err.header() == \"Input Error\") and (err.message == \"missing value\")",
        "end"
      ]},
      "features": ["errors", "unions", "text"],
      "reservedWords": ["fun", "return", "end", "do", "and"]
    },
    {
      "id": "errors-channel-send-after-close",
      "name": "Channel send failure",
      "description": "Propagate the Error returned by a send attempted after channel closure.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun send_after_close(h: Heap): Nil | Error do",
        "    let channel: Channel\u003cInt32\u003e = try Channel\u003cInt32\u003e(h, 1)",
        "    defer channel.free(h)",
        "    channel.close()",
        "    try channel.send(1)",
        "    return nil",
        "end"
      ]},
      "features": ["errors", "try-errdefer", "channels", "defer"],
      "reservedWords": ["fun", "try", "defer", "return", "nil", "end", "do"]
    },
    {
      "id": "errors-success-failure-cleanup",
      "name": "Success and failure cleanup",
      "description": "Combine defer and errdefer across successful and fallible paths.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun cleanup() do",
        "end",
        "fun work(fail: Bool): Nil | Error do",
        "    defer cleanup()",
        "    errdefer cleanup()",
        "    if fail then",
        "        return Error(ErrorKind.Other(header = \"Work Error\"), \"failed\")",
        "    end",
        "    return nil",
        "end"
      ]},
      "features": ["errors", "try-errdefer", "defer"],
      "reservedWords": ["fun", "defer", "errdefer", "if", "then", "return", "nil", "end", "do"]
    },
    {
      "id": "errors-try-multi-union",
      "name": "Try with multiple successes",
      "description": "Use try on a union with several success members; Error is stripped and the full success union is preserved.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
