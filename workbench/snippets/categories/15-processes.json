{
  "id": "processes",
  "name": "Processes and IPC",
  "snippets": [
    {
      "description": "Build a ProcessOptions request, start the child, and match its ExitStatus once it exits.",
      "entrypoint": "app.hex",
      "features": [
        "processes",
        "errors",
        "try-errdefer",
        "collections"
      ],
      "id": "processes-spawn-and-wait",
      "name": "Spawn a process and wait for it",
      "reservedWords": [
        "fun",
        "do",
        "end",
        "try",
        "return",
        "nil",
        "match",
        "is",
        "then"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Proc from std.process",
          "end",
          "fun run_worker(h: Heap): Int64 | Error do",
          "    let arguments: List\u003cString\u003e = List\u003cString\u003e(h)",
          "    arguments.push(\"--once\")",
          "    let options: Proc.ProcessOptions = Proc.ProcessOptions(",
          "        program = \"worker\",",
          "        arguments = arguments,",
          "        environment = Proc.Environment.Inherit(),",
          "        working_directory = nil,",
          "        input = Proc.ProcessStream.Inherit(),",
          "        output = Proc.ProcessStream.Ignore(),",
          "        error = Proc.ProcessStream.Ignore(),",
          "    )",
          "    let started: Proc.StartedProcess = try Proc.start(options)",
          "    let status: Proc.ExitStatus = try started.process.wait()",
          "    try started.process.close()",
          "    return match status is",
          "    | Proc.ExitStatus.Exited then status.code",
          "    | Proc.ExitStatus.Terminated then -1",
          "    end",
          "end",
          "let code: Int64 | Error = run_worker(Heap())"
        ]
      }
    },
    {
      "description": "Spawn a child with a piped stdout and drain it into a byte list before waiting for exit.",
      "entrypoint": "app.hex",
      "features": [
        "processes",
        "errors",
        "try-errdefer",
        "collections",
        "nullability"
      ],
      "id": "processes-pipe-output",
      "name": "Read a child's piped output",
      "reservedWords": [
        "fun",
        "do",
        "end",
        "try",
        "return",
        "nil",
        "if",
        "then",
        "is",
        "defer"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Proc from std.process",
          "end",
          "fun run_worker(h: Heap): Nil | Error do",
          "    let options: Proc.ProcessOptions = Proc.ProcessOptions(",
          "        program = \"worker\",",
          "        arguments = List\u003cString\u003e(h),",
          "        environment = Proc.Environment.Inherit(),",
          "        working_directory = nil,",
          "        input = Proc.ProcessStream.Ignore(),",
          "        output = Proc.ProcessStream.Pipe(),",
          "        error = Proc.ProcessStream.Ignore(),",
          "    )",
          "    let started: Proc.StartedProcess = try Proc.start(options)",
          "    let output: Proc.Pipe | Nil = started.output",
          "    if output != nil then",
          "        let buffer: List\u003cByte\u003e = List\u003cByte\u003e(h)",
          "        defer buffer.free(h)",
          "        let received: Size | EoS = try output.read(buffer, 256)",
          "        if received is Size then",
          "            try output.write(\"ack\".bytes())",
          "        end",
          "        try output.close()",
          "    end",
          "    try started.process.wait()",
          "    try started.process.close()",
          "    return nil",
          "end",
          "let done: Nil | Error = run_worker(Heap())"
        ]
      }
    }
  ]
}
