    {
      "id": "streams-adapter-chain",
      "name": "Adapter chain",
      "description": "Compose filter, map, and take over one Heap, and stop using the upstream handles.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun is_even(value: Int32): Bool do",
        "    return value % 2 == 0",
        "end",
        "fun double(value: Int32): Int32 do",
        "    return value * 2",
        "end",
        "fun demo(h: Heap) do",
        "    values: List<Int32> = List<Int32>.new(h)",
        "    defer values.free(h)",
        "    values.push(1)",
        "    values.push(2)",
        "    source: Stream<Int32> = values.stream(h)",
        "    even: Stream<Int32> = source.filter(h, is_even)",
        "    doubled: Stream<Int32> = even.map(h, double)",
        "    limited: Stream<Int32> = doubled.take(h, 2)",
        "    defer limited.free(h)",
        "    step: Int32 | EoS = limited.next()",
        "end"
      ]},
      "features": ["streams"],
      "reservedWords": ["fun", "return", "defer", "end", "do"]
    },
    {
      "id": "streams-produce",
      "name": "Custom producer",
      "description": "Drive a stream from inline state and a named callback.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Counter = {",
        "    mut current: Int32,",
        "    limit: Int32,",
        "}",
        "fun counter_next(state: MutPtr<Counter>): Int32 | EoS do",
        "    if state.current >= state.limit then",
        "        return eos",
        "    end",
        "    result: Int32 = state.current",
        "    state.current = state.current + 1",
        "    return result",
        "end",
        "fun demo(h: Heap) do",
        "    initial: Counter = Counter { current = 0, limit = 3 }",
        "    numbers: Stream<Int32> = Stream<Int32>.produce(h, initial, counter_next)",
        "    defer numbers.free(h)",
        "    step: Int32 | EoS = numbers.next()",
        "end"
      ]},
      "features": ["streams"],
      "reservedWords": ["type", "mut", "fun", "if", "return", "eos", "end", "defer", "do", "then"]
    },
    {
      "id": "streams-cleanup",
      "name": "Stream cleanup",
      "description": "Free the adapter chain once; exhaustion alone releases nothing.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun is_even(value: Int32): Bool do",
        "    return value % 2 == 0",
        "end",
        "fun demo(h: Heap) do",
        "    values: List<Int32> = List<Int32>.new(h)",
        "    defer values.free(h)",
        "    values.push(1)",
        "    values.push(2)",
        "    source: Stream<Int32> = values.stream(h)",
        "    filtered: Stream<Int32> = source.filter(h, is_even)",
        "    step: Int32 | EoS = filtered.next()",
        "    filtered.free(h)",
        "end"
      ]},
      "features": ["streams", "defer"],
      "reservedWords": ["fun", "return", "defer", "end", "do"]
    }
  ]
