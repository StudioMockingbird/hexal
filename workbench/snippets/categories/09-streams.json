    {
      "id": "streams-for-iteration",
      "name": "Stream iteration",
      "description": "Consume a stream with for ... in until it completes.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap) do",
        "    values: List<Int32> = List<Int32>.new(h)",
        "    defer values.free(h)",
        "    values.push(1)",
        "    values.push(2)",
        "    source: Stream<Int32> = values.stream(h)",
        "    defer source.free(h)",
        "    mut total: Int32 = 0",
        "    for value in source do",
        "        total = total + value",
        "    end",
        "end"
      ]},
      "features": ["streams", "for"],
      "reservedWords": ["fun", "mut", "defer", "for", "in", "do", "end"]
