      "id": "streams-empty",
      "name": "Empty stream",
      "description": "Create an allocation-free empty stream and observe immediate EoS.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo() do",
        "    empty: Stream<Int32> = Stream<Int32>.new()",
        "    step: Int32 | EoS = empty.next()",
        "    if step is EoS then",
        "        print(\"empty\")",
        "    end",
        "end"
      ]},
      "features": ["streams", "print"],
      "reservedWords": ["fun", "if", "is", "end", "do", "then"]
