{
  "id": "terminal",
  "name": "Terminal",
  "snippets": [
    {
      "id": "terminal-describe-stdout",
      "name": "Detect a terminal and read its size",
      "description": "Check whether stdout is an attached terminal, then read its visible dimensions when it is.",
      "entrypoint": "app.hex",
      "sources": {
        "app.hex": [
          "fun describe(stream: IO): TerminalSize | Error do",
          "    attached: Bool := try Terminal.is_attached(stream)",
          "    if attached then",
          "        size: TerminalSize := try Terminal.size(stream)",
          "        return size",
          "    end",
          "    return Error(ErrorKind.InvalidInput(), \"not attached\")",
          "end",
          "fun run(): TerminalSize | Error do",
          "    stream: IO := try IO.stdout()",
          "    return describe(stream)",
          "end",
          "out: TerminalSize | Error := run()"
        ]
      },
      "features": ["terminal", "errors", "try-errdefer"],
      "reservedWords": ["fun", "do", "end", "try", "if", "then", "return"]
    }
  ]
}
