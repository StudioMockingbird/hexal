{
  "id": "control-flow",
  "name": "Control Flow",
  "snippets": [
    {
      "id": "control-grade-bands",
      "name": "Grade bands",
      "description": "Uses an if/elseif/else chain to classify a score.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun band(score: Int32): Strand do",
        "    if score >= 90 then",
        "        return \"A\"",
        "    elseif score >= 75 then",
        "        return \"B\"",
        "    else",
        "        return \"C\"",
        "    end",
        "end",
        "grade: Strand:= band(82)"
      ]},
      "features": ["functions", "if-elseif-else"],
      "reservedWords": ["fun", "if", "elseif", "else", "return", "end", "do", "then"]
    },
    {
      "id": "control-search-break",
      "name": "Search with break",
      "description": "Scans an array and stops when a matching value is found.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "values: Array<Int32, 4>:= [3, 7, 2, 9]",
        "mut found: Bool:= false",
        "mut index: Int32:= 0",
        "while index < 4 do",
        "    if values[index] == 7 then",
        "        found = true",
        "        break",
        "    end",
        "    index = index + 1",
        "end"
      ]},
      "features": ["while", "arrays"],
      "reservedWords": ["mut", "while", "do", "if", "break", "end", "true", "false", "then"]
    },
    {
      "id": "control-filter-continue",
      "name": "Filter with continue",
      "description": "Iterates through values while skipping unwanted elements.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun sum_nonzero() do",
        "    values: Array<Int32, 5>:= [1, 0, 3, 0, 5]",
        "    mut total: Int32:= 0",
        "    for value in values do",
        "        if value == 0 then",
        "            continue",
        "        end",
        "        total = total + value",
        "    end",
        "end"
      ]},
      "features": ["for", "arrays"],
      "reservedWords": ["fun", "for", "in", "do", "if", "continue", "end", "mut", "then"]
    },
    {
      "id": "control-bounded-counter",
      "name": "Bounded counter",
      "description": "Uses a while loop with a changing termination condition.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut count: Int32:= 0",
        "mut limit: Int32:= 5",
        "while count < limit do",
        "    count = count + 1",
        "    if count > 2 then",
        "        limit = limit + 2",
        "    end",
        "end"
      ]},
      "features": ["while", "bindings"],
      "reservedWords": ["mut", "while", "do", "if", "end", "then"]
    },
    {
      "id": "control-nested-coordinate-scan",
      "name": "Nested coordinate scan",
      "description": "Traverses a small grid using nested loops.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun scan_grid() do",
        "    grid: Array<Array<Int32, 3>, 2>:= [[1, 2, 3], [4, 5, 6]]",
        "    mut total: Int32:= 0",
        "    for row in grid do",
        "        for cell in row do",
        "            total = total + cell",
        "        end",
        "    end",
        "end"
      ]},
      "features": ["for", "arrays"],
      "reservedWords": ["fun", "for", "in", "do", "end", "mut"]
    },
    {
      "id": "control-indexed-total",
      "name": "Indexed total",
      "description": "Uses for index, value in array to calculate a weighted total.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun weighted_total() do",
        "    scores: Array<Int32, 3>:= [10, 20, 30]",
        "    mut weighted: Int32:= 0",
        "    for index, value in scores do",
        "        weighted = weighted + value * (index.to<Int32>() + 1)",
        "    end",
        "end"
      ]},
      "features": ["for", "arrays"],
      "reservedWords": ["fun", "for", "in", "do", "end", "mut"]
    },
    {
      "id": "control-three-value-iteration",
      "name": "Three-value iteration",
      "description": "Uses the supported three-binder for ... in form to expose iteration context.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap) do",
        "    names: Dict<Int32, Strand>:= Dict<Int32, Strand>.new(h)",
        "    defer names.free(h)",
        "    names.insert(1, \"one\")",
        "    names.insert(2, \"two\")",
        "    mut pairs: Int32:= 0",
        "    for index, key, value in names do",
        "        pairs = pairs + index.to<Int32>() + key + value.length().to<Int32>()",
        "    end",
        "end"
      ]},
      "features": ["for", "dicts"],
      "reservedWords": ["fun", "defer", "for", "in", "do", "end", "mut"]
    },
    {
      "id": "control-guarded-update",
      "name": "Guarded update",
      "description": "Rejects an invalid state early before performing an update.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun apply_damage(health: MutPtr<Int32>, amount: Int32): Bool do",
        "    if amount <= 0 then",
        "        return false",
        "    end",
        "    health.value = health.value - amount",
        "    return true",
        "end",
        "mut hp: Int32:= 10",
        "applied: Bool:= apply_damage(ref hp, 3)"
      ]},
      "features": ["functions", "pointers"],
      "reservedWords": ["fun", "if", "return", "end", "mut", "ref", "false", "true", "do", "then"]
    },
    {
      "id": "control-boolean-state-machine",
      "name": "Boolean state machine",
      "description": "Moves through a small state sequence using conditions and a mutable label.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut phase: Int32:= 0",
        "mut running: Bool:= true",
        "while running do",
        "    if phase == 0 then",
        "        phase = 1",
        "    elseif phase == 1 then",
        "        phase = 2",
        "    else",
        "        running = false",
        "    end",
        "end"
      ]},
      "features": ["while", "bindings"],
      "reservedWords": ["mut", "while", "do", "if", "elseif", "else", "end", "true", "false", "then"]
    },
    {
      "id": "control-truthiness",
      "name": "Truthiness",
      "description": "Shows that only false and nil are falsey: a zero integer, an empty text value, and an empty collection all take the truthy branch.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "count: Int32:= 0",
        "label: Strand:= \"\"",
        "values: View<Int32>:= View<Int32>.empty()",
        "mut truthy: Int32:= 0",
        "if count then",
        "    truthy = truthy + 1",
        "end",
        "if label then",
        "    truthy = truthy + 1",
        "end",
        "if values then",
        "    truthy = truthy + 1",
        "end"
      ]},
      "features": ["truthiness", "bindings"],
      "reservedWords": ["mut", "if", "end", "then"]
    }
  ]
}
