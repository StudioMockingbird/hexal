      "id": "text-text-inspection",
      "name": "Text inspection",
      "description": "Read the first byte from a string through its byte slice.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Bool do",
        "    let text: String= \"caf\\u{00E9}\"",
        "    let raw: Slice\u003cByte\u003e = text.bytes()",
        "    let first_byte: Byte= raw[0]",
        "    return (first_byte == b'c') and (raw.length() == 5)",
        "end"
      ]},
      "features": ["text", "slices"],
      "reservedWords": ["fun", "return", "end", "and", "do"]
    },
    {
      "id": "text-byte-iteration",
      "name": "Byte iteration",
      "description": "Iterate through text with a typed for binder; text is a sequence of bytes, so the element type is written.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun count_letters(text: String): Int32 do",
        "    let mut letters: Int32= 0",
        "    for b: Byte in text do",
        "        if b == b' ' then",
        "            continue",
        "        end",
        "        letters = letters + 1",
        "    end",
        "    return letters",
        "end"
      ]},
      "features": ["text", "for"],
      "reservedWords": ["fun", "for", "in", "do", "if", "continue", "return", "end", "mut", "then"]
    },
