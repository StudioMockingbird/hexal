    {
      "id": "text-protocol-parser",
      "name": "Text protocol",
      "description": "Small tokenizing parser loop over String runes, terminated by EoS; longer than 20 lines because it demonstrates as, match, then, and eos together.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Token = | Digit as { value: Rune } | Other as { value: Rune }",
        "",
        "fun next_token(cursor: RuneCursor): Token | EoS do",
        "    if !cursor.has_next() then",
        "        return eos",
        "    end",
        "    letter: Rune = cursor.next()",
        "    token: Token = match letter >= '0' and letter <= '9'",
        "    | true then Token.Digit { value = letter }",
        "    | false then Token.Other { value = letter }",
        "    end",
        "    return token",
        "end",
        "",
        "fun digit_sum(text: String): Int32 do",
        "    cursor: RuneCursor = text.rune_cursor()",
        "    mut total: Int32 = 0",
        "    while true do",
        "        step: Token | EoS = next_token(cursor)",
        "        if step is EoS then",
        "            break",
        "        end",
        "        add: Int32 = (match step is | Token.Digit then 1 | Token.Other then 0 end)",
        "        total = total + add",
        "    end",
        "    return total",
        "end"
      ]},
      "features": ["text", "adts", "match"],
      "reservedWords": ["type", "fun", "if", "return", "end", "match", "while", "do", "break", "mut", "then", "as", "eos", "is"]
    }
