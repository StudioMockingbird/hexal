      "name": "Text comparison",
      "description": "Compare String values by bytes and order them lexicographically.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Bool do",
        "    left: String = \"abc\"",
        "    right: String = \"abd\"",
        "    same: Bool = left == right",
        "    ordered: Bool = left < right",
        "    key: Strand = \"abc\"",
