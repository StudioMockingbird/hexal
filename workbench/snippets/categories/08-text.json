    {
      "id": "text-text-inspection",
      "name": "Text inspection",
      "description": "Read the first rune and first byte from a string.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Bool do",
        "    let text: String= \"caf\\u{00E9}\"",
        "    let cursor: RuneCursor= text.rune_cursor()",
        "    let first: Rune= cursor.next()",
        "    let raw: Slice\u003cByte\u003e = text.bytes()",
        "    let first_byte: Byte= raw[0]",
        "    return (first == 'c') and (first_byte == b'c')",
        "end"
      ]},
      "features": ["text", "slices"],
      "reservedWords": ["fun", "return", "end", "and", "do"]
    },
    {
      "id": "text-rune-cursor",
      "name": "Rune cursor",
      "description": "Iterate through text using a RuneCursor.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun count_letters(text: String): Int32 do",
        "    let cursor: RuneCursor= text.rune_cursor()",
        "    let mut letters: Int32= 0",
        "    while cursor.has_next() do",
        "        let value: Rune= cursor.next()",
        "        if value == ' ' then",
        "            continue",
        "        end",
        "        letters = letters + 1",
        "    end",
        "    return letters",
        "end"
      ]},
      "features": ["text", "while"],
      "reservedWords": ["fun", "while", "do", "if", "continue", "return", "end", "mut", "then"]
    },
