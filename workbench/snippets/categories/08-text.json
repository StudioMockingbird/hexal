    {
      "id": "text-string-building",
      "name": "String building",
      "description": "Build a runtime String with concat and copy, then free it exactly once.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun load_body(h: Heap): String | Error do",
        "    return \"ready\".copy(h)",
        "end",
        "fun build_report(h: Heap): Int32 | Error do",
        "    let prefix: String= \"report: \".copy(h)",
        "    errdefer prefix.free(h)",
        "    let body: String= try load_body(h)",
        "    errdefer body.free(h)",
        "    let full: String= try prefix.concat(h, body.bytes())",
        "    let length: Size= full.length()",
        "    body.free(h)",
        "    full.free(h)",
        "    prefix.free(h)",
        "    return length.to\u003cInt32\u003e()",
        "end"
      ]},
      "features": ["text", "errors", "try-errdefer"],
      "reservedWords": ["fun", "return", "end", "errdefer", "try", "do"]
    },
    {
      "id": "text-inline-string",
      "name": "Inline text",
      "description": "Use String\u003cN\u003e as an inline value with a fixed capacity, widen it explicitly, and copy it to a heap String.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Bool do",
        "    let label: String\u003c16\u003e = \"hexal\"",
        "    let empty: Bool= label.length() == 0",
        "    let wide: String\u003c64\u003e = label.widen\u003c64\u003e()",
        "    let text: String= wide.copy(h)",
        "    let count: Size= text.length()",
        "    text.free(h)",
        "    return (count == 5) and (empty == false)",
        "end"
      ]},
      "features": ["text", "literals"],
