      "id": "text-interpolation-order",
      "name": "Interpolation evaluation order",
      "description": "Embedded expressions in an interpolation template evaluate exactly once, left to right.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun tick(counter: Ptr<mut Int32>): Int32 do",
        "    let value: Int32= ^counter",
        "    ^counter = value + 1",
        "    return value",
        "end",
        "fun demo(): Bool do",
        "    let heap: Heap= Heap()",
        "    let counter: Ptr\u003cmut Int32\u003e = heap.allocate\u003cInt32\u003e(0)",
        "    let message: String= String.interpolate(heap, \"first={{tick(counter)}} second={{tick(counter)}}\")",
        "    defer message.free(heap)",
        "    defer heap.free(counter)",
        "    return message.length() == 16",
        "end"
      ]},
      "features": ["text", "heap-allocation", "pointers", "defer"],
