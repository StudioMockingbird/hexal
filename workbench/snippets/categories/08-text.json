    {
      "id": "text-comparison",
      "name": "Text comparison",
      "description": "Compare text by bytes and order it lexicographically, across String and inline String\u003cN\u003e values.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(): Bool do",
        "    let left: String= \"abc\"",
        "    let right: String= \"abd\"",
        "    let same: Bool= left == right",
        "    let ordered: Bool= left \u003c right",
        "    let key: String\u003c8\u003e = \"abc\"",
        "    let inline_less: Bool= key \u003c \"abd\"",
        "    let crossed: Bool= key == left",
        "    return !same and ordered and inline_less and crossed",
        "end"
      ]},
      "features": ["text", "equality-ordering"],
      "reservedWords": ["fun", "return", "end", "and", "do"]
    },
    {
      "id": "text-protocol-parser",
      "name": "Text protocol",
      "description": "Small tokenizing parser loop over String bytes, terminated by EoS; longer than 20 lines because it demonstrates as, match, then, and eos together.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Token is union | Digit as value: Byte end | Other as value: Byte end end",
        "",
        "fun next_token(bytes: Slice\u003cByte\u003e, position: Size): Token | EoS do",
        "    if position \u003e= bytes.length() then",
        "        return eos",
        "    end",
        "    let letter: Byte= bytes[position]",
        "    let token: Token= match (letter \u003e= b'0') and (letter \u003c= b'9')",
        "    | true then Token.Digit(value = letter)",
        "    | false then Token.Other(value = letter)",
        "    end",
        "    return token",
        "end",
        "",
        "fun digit_sum(text: String): Int32 do",
        "    let bytes: Slice\u003cByte\u003e = text.bytes()",
        "    let mut position: Size= 0",
        "    let mut total: Int32= 0",
        "    while true do",
        "        let step: Token | EoS= next_token(bytes, position)",
        "        if step is EoS then",
        "            break",
        "        end",
        "        let add: Int32= (match step is | Token.Digit then 1 | Token.Other then 0 end)",
        "        total = total + add",
        "        position = position + 1",
        "    end",
        "    return total",
        "end"
      ]},
      "features": ["text", "adts", "match"],
      "reservedWords": ["type", "fun", "if", "return", "end", "match", "while", "do", "break", "mut", "then", "as", "eos", "is"]
