    {
      "id": "text-string-building",
      "name": "String building",
      "description": "Build a runtime String with concat and to_string, then free it exactly once.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun load_body(h: Heap): String | Error do",
        "    return \"ready\".to_string(h)",
        "end",
        "fun build_report(h: Heap): Int32 | Error do",
        "    let prefix: String= \"report: \".to_string(h)",
        "    errdefer prefix.free(h)",
        "    let body: String= try load_body(h)",
        "    let full: String= prefix.concat(h, body)",
        "    let length: Size= full.length()",
        "    body.free(h)",
        "    full.free(h)",
        "    prefix.free(h)",
        "    return length.to<Int32>()",
        "end"
      ]},
      "features": ["text", "errors", "try-errdefer"],
      "reservedWords": ["fun", "return", "end", "errdefer", "try", "do"]
    },
