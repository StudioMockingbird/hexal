{
  "id": "pointers-and-memory",
  "name": "Pointers and Memory",
  "snippets": [
    {
      "id": "memory-read-pointer",
      "name": "Read pointer",
      "description": "Create a read-only pointer and read its value.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "let mut score: Int32= 42",
        "let reader: Ptr\u003cInt32\u003e = @score",
        "let doubled: Int32= ^reader * 2"
      ]},
      "features": ["pointers"],
      "reservedWords": ["mut", "@"]
    },
    {
      "id": "memory-mutable-pointer",
      "name": "Mutable pointer",
      "description": "Update a variable through Ptr<mut T>.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "let mut score: Int32= 10",
        "let writer: Ptr\u003cmut Int32\u003e = @score",
        "^writer = ^writer + 5"
      ]},
      "features": ["pointers"],
      "reservedWords": ["mut", "@"]
    },
    {
      "id": "memory-nullable-pointer",
      "name": "Nullable pointer",
      "description": "Handle a pointer that may contain nil.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun total(maybe: Ptr<Int32> | Nil): Int32 do",
        "    if maybe != nil then",
        "        return ^maybe",
        "    end",
        "    return 0",
        "end",
        "let mut value: Int32= 5",
        "let present: Ptr\u003cInt32\u003e | Nil= @value",
        "let absent: Ptr\u003cInt32\u003e | Nil= nil",
        "let result: Int32= total(present) + total(absent)"
      ]},
      "features": ["pointers", "nullability", "unions"],
      "reservedWords": ["fun", "if", "return", "end", "mut", "@", "nil", "do", "then"]
    },
    {
      "id": "memory-pointer-view",
      "name": "Pointer slice",
      "description": "Convert pointer plus length into a bounded Slice<T>.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    let p: Ptr\u003cmut Int32\u003e = h.allocate\u003cInt32\u003e(7)",
        "    unsafe do",
        "        let view: Slice\u003cInt32\u003e = Slice\u003cInt32\u003e.from_pointer(p, 1)",
        "        return view[0]",
        "    end",
        "end"
      ]},
      "features": ["pointers", "slices", "slice-pointer-bridge", "heap-allocation", "unsafe"],
      "reservedWords": ["fun", "return", "end", "do", "unsafe"]
    },
    {
      "id": "memory-unsafe-block",
      "name": "Unsafe block",
      "description": "Grant permission for operations whose preconditions only the programmer can assert.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun total(p: Ptr<mut Int32>, count: Size): Int32 do",
        "    let mut sum: Int32= 0",
        "    unsafe do",
        "        let bytes: Slice\u003cInt32\u003e = Slice\u003cInt32\u003e.from_pointer(p, count)",
        "        for value in bytes do",
        "            sum = sum + value",
        "        end",
        "    end",
        "    return sum",
        "end",
        "fun demo(h: Heap): Int32 do",
        "    let p: Ptr\u003cmut Int32\u003e = h.allocate\u003cInt32\u003e(41)",
        "    defer h.free(p)",
        "    return total(p, 1)",
        "end"
      ]},
      "features": ["unsafe", "pointers", "slices", "slice-pointer-bridge", "heap-allocation"],
      "reservedWords": ["fun", "return", "end", "do", "for", "in", "mut", "defer", "unsafe"]
    },
    {
      "id": "memory-pointer-arithmetic",
      "name": "Pointer arithmetic",
      "description": "Traverse and reinterpret raw addresses inside an unsafe block.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    let block: Ptr\u003cmut Array\u003cInt32, 4\u003e\u003e = h.allocate\u003cArray\u003cInt32, 4\u003e\u003e([10, 20, 30, 40])",
        "    defer h.free(block)",
        "    unsafe do",
        "        let first: Ptr\u003cmut Int32\u003e = block.cast\u003cInt32\u003e()",
        "        let third: Ptr\u003cmut Int32\u003e = first.offset(2)",
        "        return first[1] + (^third)",
        "    end",
        "end"
      ]},
      "features": ["pointer-arithmetic", "unsafe", "pointers", "heap-allocation", "arrays"],
      "reservedWords": ["fun", "return", "end", "do", "defer", "unsafe"]
    },
    {
      "id": "memory-opaque-pointer",
      "name": "Opaque pointer",
      "description": "Erase and restore a pointer through Unknown.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "let mut value: Int32= 1",
        "let reader: Ptr\u003cInt32\u003e = @value",
        "let erased: Ptr\u003cUnknown\u003e = reader",
        "let restored: Ptr\u003cInt32\u003e = erased",
        "let result: Int32= ^restored"
      ]},
      "features": ["pointers", "unknown-pointers"],
      "reservedWords": ["mut", "@"]
    },
    {
      "id": "memory-heap-integer",
      "name": "Heap integer",
      "description": "Allocate an integer, update it, and release it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    let p: Ptr\u003cmut Int32\u003e = h.allocate\u003cInt32\u003e(1)",
        "    defer h.free(p)",
        "    ^p = ^p + 41",
        "    let result: Int32= ^p",
        "    return result",
        "end"
      ]},
      "features": ["heap-allocation", "pointers"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-heap-aligned",
      "name": "Aligned heap allocation",
      "description": "Allocate an over-aligned heap object and release it normally.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    let p: Ptr\u003cmut Int32\u003e = h.allocate_aligned\u003cInt32\u003e(13, 64)",
        "    defer h.free(p)",
        "    let natural: Ptr\u003cmut Int32\u003e = h.allocate_aligned\u003cInt32\u003e(29, align_of\u003cInt32\u003e())",
        "    defer h.free(natural)",
        "    return ^p + ^natural",
        "end"
      ]},
      "features": ["aligned-allocation", "heap-allocation", "pointers", "layout"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-deferred-free",
      "name": "Deferred free",
      "description": "Ensure heap cleanup runs when a function returns.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    let p: Ptr\u003cmut Int32\u003e = h.allocate\u003cInt32\u003e(1)",
        "    defer h.free(p)",
        "    let q: Ptr\u003cmut Int32\u003e = h.allocate\u003cInt32\u003e(2)",
        "    defer h.free(q)",
        "    ^p = ^p + ^q",
        "    return ^p",
        "end"
      ]},
      "features": ["heap-allocation", "defer", "pointers"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-heap-object",
      "name": "Heap object",
      "description": "Allocate a small object and mutate it through a pointer.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Counter is struct mut count: Int32 end",
        "fun demo(h: Heap): Int32 do",
        "    let p: Ptr\u003cmut Counter\u003e = h.allocate\u003cCounter\u003e(Counter(count = 0))",
        "    defer h.free(p)",
        "    p.count = p.count + 3",
        "    let result: Int32= p.count",
        "    return result",
        "end"
      ]},
      "features": ["heap-allocation", "objects", "pointers"],
      "reservedWords": ["type", "fun", "defer", "mut", "return", "end", "do"]
    },
    {
      "id": "memory-pointer-swap",
      "name": "Pointer-based swap",
      "description": "Exchange two values through mutable pointers.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun swap(a: Ptr<mut Int32>, b: Ptr<mut Int32>) do",
        "    let temp: Int32= ^a",
        "    ^a = ^b",
        "    ^b = temp",
        "end",
        "fun demo(): Int32 do",
        "    let mut left: Int32= 1",
        "    let mut right: Int32= 2",
        "    swap(@left, @right)",
        "    return left + (right * 10)",
        "end"
      ]},
      "features": ["pointers", "functions", "no-result-functions"],
      "reservedWords": ["fun", "mut", "return", "end", "@", "do"]
    },
    {
      "id": "memory-volatile-register",
      "name": "Volatile register",
      "description": "Write and read a simulated memory-mapped register.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun write_register(register: Ptr<mut UInt32>) do",
        "    register.write_volatile(0x10)",
        "end",
        "fun demo(): UInt32 do",
        "    let mut storage: UInt32= 0",
        "    let register: Ptr\u003cmut UInt32\u003e = @storage",
        "    write_register(register)",
        "    let status: UInt32= register.read_volatile()",
        "    return status",
        "end"
      ]},
      "features": ["volatile", "pointers"],
      "reservedWords": ["fun", "mut", "return", "end", "@", "do"]
    },
    {
      "id": "memory-array-element-pointer",
      "name": "Array element pointer",
      "description": "Take a mutable pointer to an array element and update it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun bump(value: Ptr<mut Int32>) do",
        "    ^value = ^value + 1",
        "end",
        "fun demo(): Int32 do",
        "    let mut values: Array\u003cInt32, 2\u003e = [1, 2]",
        "    bump(@values[1])",
        "    return values[1]",
        "end"
      ]},
      "features": ["pointers", "arrays", "functions", "no-result-functions"],
      "reservedWords": ["fun", "mut", "return", "end", "@", "do"]
    },
    {
      "id": "memory-object-member-pointer",
      "name": "Object member pointer",
      "description": "Take a pointer to an object field and use it through the pointer.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Counter is struct mut value: Int32 end",
        "fun increment(value: Ptr<mut Int32>) do",
        "    ^value = ^value + 1",
        "end",
        "fun demo(): Int32 do",
        "    let mut counter: Counter= Counter(value = 4)",
        "    increment(@counter.value)",
        "    return counter.value",
        "end"
      ]},
      "features": ["pointers", "objects", "functions", "no-result-functions"],
      "reservedWords": ["type", "mut", "fun", "return", "end", "@", "do"]
    },
    {
      "id": "memory-heap-alias-lifetime",
      "name": "Heap alias lifetime",
      "description": "Create shallow pointer aliases and perform one explicit cleanup.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    let value: Ptr\u003cmut Int32\u003e = h.allocate\u003cInt32\u003e(42)",
        "    let alias: Ptr\u003cInt32\u003e = value",
        "    defer h.free(value)",
        "    return ^alias",
        "end"
      ]},
      "features": ["pointers", "heap-allocation", "defer", "copying"],
      "reservedWords": ["fun", "return", "end", "defer", "do"]
    },
    {
      "id": "memory-stash-bump-allocate",
      "name": "Stash bump allocation",
      "description": "Allocate a typed Stash region and release it as one block.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Node is struct amount: Int32 end",
        "fun demo(): Int32 do",
        "    let stash = Stash\u003cNode\u003e()",
        "    defer stash.destroy()",
        "    let first: Ptr\u003cmut Node\u003e = stash.allocate(Node(amount = 1))",
        "    let second: Ptr\u003cmut Node\u003e = stash.allocate(Node(amount = 2))",
        "    return (^first).amount + (^second).amount",
        "end"
      ]},
      "features": ["stash", "heap-allocation", "pointers", "defer"],
      "reservedWords": ["type", "fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-stash-reset-reuse",
      "name": "Stash reset and reuse",
      "description": "Reset a Stash to reuse its high-water allocation for a fresh batch.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Node is struct amount: Int32 end",
        "fun demo(): Int32 do",
        "    let stash = Stash\u003cNode\u003e()",
        "    defer stash.destroy()",
        "    let first: Ptr\u003cmut Node\u003e = stash.allocate(Node(amount = 1))",
        "    let result: Int32= (^first).amount",
        "    stash.reset()",
        "    let second: Ptr\u003cmut Node\u003e = stash.allocate(Node(amount = 2))",
        "    return result + (^second).amount",
        "end"
      ]},
      "features": ["stash", "heap-allocation", "pointers", "defer"],
      "reservedWords": ["type", "fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-pool-fixed-capacity",
      "name": "Pool fixed capacity",
      "description": "Allocate, free, and destroy slots in a fixed-capacity Pool.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Node is struct amount: Int32 end",
        "fun demo(): Int32 do",
        "    let pool = Pool\u003cNode\u003e(4)",
        "    defer pool.destroy()",
        "    let first: Ptr\u003cmut Node\u003e = pool.allocate(Node(amount = 10))",
        "    let second: Ptr\u003cmut Node\u003e = pool.allocate(Node(amount = 20))",
        "    let result: Int32= (^first).amount + (^second).amount",
        "    pool.free(first)",
        "    pool.free(second)",
        "    return result",
        "end"
      ]},
      "features": ["pool", "heap-allocation", "pointers", "defer"],
      "reservedWords": ["type", "fun", "defer", "return", "end", "do"]
    }
  ]
}
