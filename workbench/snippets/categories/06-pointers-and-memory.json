{
  "id": "pointers-and-memory",
  "name": "Pointers and Memory",
  "snippets": [
    {
      "id": "memory-read-pointer",
      "name": "Read pointer",
      "description": "Create a read-only pointer and read its value.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut score: Int32 = 42",
        "reader: Ptr<Int32> = ref score",
        "doubled: Int32 = reader.value * 2"
      ]},
      "features": ["pointers"],
      "reservedWords": ["mut", "ref"]
    },
    {
      "id": "memory-mutable-pointer",
      "name": "Mutable pointer",
      "description": "Update a variable through MutPtr<T>.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut score: Int32 = 10",
        "writer: MutPtr<Int32> = ref score",
        "writer.value = writer.value + 5"
      ]},
      "features": ["pointers"],
      "reservedWords": ["mut", "ref"]
    },
    {
      "id": "memory-nullable-pointer",
      "name": "Nullable pointer",
      "description": "Handle a pointer that may contain nil.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun total(maybe: Ptr<Int32> | Nil): Int32 do",
        "    if maybe != nil then",
        "        return maybe.value",
        "    end",
        "    return 0",
        "end",
        "mut value: Int32 = 5",
        "present: Ptr<Int32> | Nil = ref value",
        "absent: Ptr<Int32> | Nil = nil",
        "result: Int32 = total(present) + total(absent)"
      ]},
      "features": ["pointers", "nullability", "unions"],
      "reservedWords": ["fun", "if", "return", "end", "mut", "ref", "nil", "do", "then"]
    },
    {
      "id": "memory-pointer-view",
      "name": "Pointer view",
      "description": "Convert pointer plus length into a bounded View<T>.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    p: MutPtr<Int32> = h.allocate<Int32>(7)",
        "    view: View<Int32> = View<Int32>.from_pointer(p, 1)",
        "    return view[0]",
        "end"
      ]},
      "features": ["pointers", "views", "view-pointer-bridge", "heap-allocation"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "memory-opaque-pointer",
      "name": "Opaque pointer",
      "description": "Erase and restore a pointer through Unknown.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut value: Int32 = 1",
        "reader: Ptr<Int32> = ref value",
        "erased: Ptr<Unknown> = reader",
        "restored: Ptr<Int32> = erased",
        "result: Int32 = restored.value"
      ]},
      "features": ["pointers", "unknown-pointers"],
      "reservedWords": ["mut", "ref"]
    },
    {
      "id": "memory-heap-integer",
      "name": "Heap integer",
      "description": "Allocate an integer, update it, and release it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    p: MutPtr<Int32> = h.allocate<Int32>(1)",
        "    defer h.free(p)",
        "    p.value = p.value + 41",
        "    result: Int32 = p.value",
        "    return result",
        "end"
      ]},
      "features": ["heap-allocation", "pointers"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-deferred-free",
      "name": "Deferred free",
      "description": "Ensure heap cleanup runs when a function returns.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    p: MutPtr<Int32> = h.allocate<Int32>(1)",
        "    defer h.free(p)",
        "    q: MutPtr<Int32> = h.allocate<Int32>(2)",
        "    defer h.free(q)",
        "    p.value = p.value + q.value",
        "    return p.value",
        "end"
      ]},
      "features": ["heap-allocation", "defer", "pointers"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-heap-object",
      "name": "Heap object",
      "description": "Allocate a small object and mutate it through a pointer.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Counter = { mut count: Int32, }",
        "fun demo(h: Heap): Int32 do",
        "    p: MutPtr<Counter> = h.allocate<Counter>(Counter { count = 0 })",
        "    defer h.free(p)",
        "    p.count = p.count + 3",
        "    result: Int32 = p.count",
        "    return result",
        "end"
      ]},
      "features": ["heap-allocation", "objects", "pointers"],
      "reservedWords": ["type", "fun", "defer", "mut", "return", "end", "do"]
    },
    {
      "id": "memory-pointer-swap",
      "name": "Pointer-based swap",
      "description": "Exchange two values through mutable pointers.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun swap(a: MutPtr<Int32>, b: MutPtr<Int32>) do",
        "    temp: Int32 = a.value",
        "    a.value = b.value",
        "    b.value = temp",
        "end",
        "fun demo(): Int32 do",
        "    mut left: Int32 = 1",
        "    mut right: Int32 = 2",
        "    swap(ref left, ref right)",
        "    return left + right * 10",
        "end"
      ]},
      "features": ["pointers", "functions", "no-result-functions"],
      "reservedWords": ["fun", "mut", "return", "end", "ref", "do"]
    },
    {
      "id": "memory-volatile-register",
      "name": "Volatile register",
      "description": "Write and read a simulated memory-mapped register.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun write_register(register: MutPtr<UInt32>) do",
        "    register.write_volatile(0x10)",
        "end",
        "fun demo(): UInt32 do",
        "    mut storage: UInt32 = 0",
        "    register: MutPtr<UInt32> = ref storage",
        "    write_register(register)",
        "    status: UInt32 = register.read_volatile()",
        "    return status",
        "end"
      ]},
      "features": ["volatile", "pointers"],
      "reservedWords": ["fun", "mut", "return", "end", "ref", "do"]
    }
  ]
}
