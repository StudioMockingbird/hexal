{
  "id": "pointers-and-memory",
  "name": "Pointers and Memory",
  "snippets": [
    {
      "id": "memory-read-pointer",
      "name": "Read pointer",
      "description": "Create a read-only pointer and read its value.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut score: Int32:= 42",
        "reader: Ptr<Int32>:= @score",
        "doubled: Int32:= ^reader * 2"
      ]},
      "features": ["pointers"],
      "reservedWords": ["mut", "@"]
    },
    {
      "id": "memory-mutable-pointer",
      "name": "Mutable pointer",
      "description": "Update a variable through Ptr<mut T>.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut score: Int32:= 10",
        "writer: Ptr<mut Int32>:= @score",
        "^writer = ^writer + 5"
      ]},
      "features": ["pointers"],
      "reservedWords": ["mut", "@"]
    },
    {
      "id": "memory-nullable-pointer",
      "name": "Nullable pointer",
      "description": "Handle a pointer that may contain nil.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun total(maybe: Ptr<Int32> | Nil): Int32 do",
        "    if maybe != nil then",
        "        return ^maybe",
        "    end",
        "    return 0",
        "end",
        "mut value: Int32:= 5",
        "present: Ptr<Int32> | Nil:= @value",
        "absent: Ptr<Int32> | Nil:= nil",
        "result: Int32:= total(present) + total(absent)"
      ]},
      "features": ["pointers", "nullability", "unions"],
      "reservedWords": ["fun", "if", "return", "end", "mut", "@", "nil", "do", "then"]
    },
    {
      "id": "memory-pointer-view",
      "name": "Pointer slice",
      "description": "Convert pointer plus length into a bounded Slice<T>.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    p: Ptr<mut Int32>:= h.allocate<Int32>(7)",
        "    view: Slice<Int32>:= Slice<Int32>.from_pointer(p, 1)",
        "    return view[0]",
        "end"
      ]},
      "features": ["pointers", "slices", "slice-pointer-bridge", "heap-allocation"],
      "reservedWords": ["fun", "return", "end", "do"]
    },
    {
      "id": "memory-opaque-pointer",
      "name": "Opaque pointer",
      "description": "Erase and restore a pointer through Unknown.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "mut value: Int32:= 1",
        "reader: Ptr<Int32>:= @value",
        "erased: Ptr<Unknown>:= reader",
        "restored: Ptr<Int32>:= erased",
        "result: Int32:= ^restored"
      ]},
      "features": ["pointers", "unknown-pointers"],
      "reservedWords": ["mut", "@"]
    },
    {
      "id": "memory-heap-integer",
      "name": "Heap integer",
      "description": "Allocate an integer, update it, and release it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    p: Ptr<mut Int32>:= h.allocate<Int32>(1)",
        "    defer h.free(p)",
        "    ^p = ^p + 41",
        "    result: Int32:= ^p",
        "    return result",
        "end"
      ]},
      "features": ["heap-allocation", "pointers"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-deferred-free",
      "name": "Deferred free",
      "description": "Ensure heap cleanup runs when a function returns.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    p: Ptr<mut Int32>:= h.allocate<Int32>(1)",
        "    defer h.free(p)",
        "    q: Ptr<mut Int32>:= h.allocate<Int32>(2)",
        "    defer h.free(q)",
        "    ^p = ^p + ^q",
        "    return ^p",
        "end"
      ]},
      "features": ["heap-allocation", "defer", "pointers"],
      "reservedWords": ["fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-heap-object",
      "name": "Heap object",
      "description": "Allocate a small object and mutate it through a pointer.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Counter is struct mut count: Int32 end",
        "fun demo(h: Heap): Int32 do",
        "    p: Ptr<mut Counter>:= h.allocate<Counter>(Counter(count = 0))",
        "    defer h.free(p)",
        "    p.count = p.count + 3",
        "    result: Int32:= p.count",
        "    return result",
        "end"
      ]},
      "features": ["heap-allocation", "objects", "pointers"],
      "reservedWords": ["type", "fun", "defer", "mut", "return", "end", "do"]
    },
    {
      "id": "memory-pointer-swap",
      "name": "Pointer-based swap",
      "description": "Exchange two values through mutable pointers.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun swap(a: Ptr<mut Int32>, b: Ptr<mut Int32>) do",
        "    temp: Int32:= ^a",
        "    ^a = ^b",
        "    ^b = temp",
        "end",
        "fun demo(): Int32 do",
        "    mut left: Int32:= 1",
        "    mut right: Int32:= 2",
        "    swap(@left, @right)",
        "    return left + (right * 10)",
        "end"
      ]},
      "features": ["pointers", "functions", "no-result-functions"],
      "reservedWords": ["fun", "mut", "return", "end", "@", "do"]
    },
    {
      "id": "memory-volatile-register",
      "name": "Volatile register",
      "description": "Write and read a simulated memory-mapped register.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun write_register(register: Ptr<mut UInt32>) do",
        "    register.write_volatile(0x10)",
        "end",
        "fun demo(): UInt32 do",
        "    mut storage: UInt32:= 0",
        "    register: Ptr<mut UInt32>:= @storage",
        "    write_register(register)",
        "    status: UInt32:= register.read_volatile()",
        "    return status",
        "end"
      ]},
      "features": ["volatile", "pointers"],
      "reservedWords": ["fun", "mut", "return", "end", "@", "do"]
    },
    {
      "id": "memory-array-element-pointer",
      "name": "Array element pointer",
      "description": "Take a mutable pointer to an array element and update it.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun bump(value: Ptr<mut Int32>) do",
        "    ^value = ^value + 1",
        "end",
        "fun demo(): Int32 do",
        "    mut values: Array<Int32, 2>:= [1, 2]",
        "    bump(@values[1])",
        "    return values[1]",
        "end"
      ]},
      "features": ["pointers", "arrays", "functions", "no-result-functions"],
      "reservedWords": ["fun", "mut", "return", "end", "@", "do"]
    },
    {
      "id": "memory-object-member-pointer",
      "name": "Object member pointer",
      "description": "Take a pointer to an object field and use it through the pointer.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Counter is struct mut value: Int32 end",
        "fun increment(value: Ptr<mut Int32>) do",
        "    ^value = ^value + 1",
        "end",
        "fun demo(): Int32 do",
        "    mut counter: Counter:= Counter(value = 4)",
        "    increment(@counter.value)",
        "    return counter.value",
        "end"
      ]},
      "features": ["pointers", "objects", "functions", "no-result-functions"],
      "reservedWords": ["type", "mut", "fun", "return", "end", "@", "do"]
    },
    {
      "id": "memory-heap-alias-lifetime",
      "name": "Heap alias lifetime",
      "description": "Create shallow pointer aliases and perform one explicit cleanup.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun demo(h: Heap): Int32 do",
        "    value: Ptr<mut Int32>:= h.allocate<Int32>(42)",
        "    alias: Ptr<Int32>:= value",
        "    defer h.free(value)",
        "    return ^alias",
        "end"
      ]},
      "features": ["pointers", "heap-allocation", "defer", "copying"],
      "reservedWords": ["fun", "return", "end", "defer", "do"]
    },
    {
      "id": "memory-stash-bump-allocate",
      "name": "Stash bump allocation",
      "description": "Allocate a typed Stash region and release it as one block.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Node is struct amount: Int32 end",
        "fun demo(): Int32 do",
        "    stash := Stash<Node>()",
        "    defer stash.destroy()",
        "    first: Ptr<mut Node>:= stash.allocate(Node(amount = 1))",
        "    second: Ptr<mut Node>:= stash.allocate(Node(amount = 2))",
        "    return (^first).amount + (^second).amount",
        "end"
      ]},
      "features": ["stash", "heap-allocation", "pointers", "defer"],
      "reservedWords": ["type", "fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-stash-reset-reuse",
      "name": "Stash reset and reuse",
      "description": "Reset a Stash to reuse its high-water allocation for a fresh batch.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Node is struct amount: Int32 end",
        "fun demo(): Int32 do",
        "    stash := Stash<Node>()",
        "    defer stash.destroy()",
        "    first: Ptr<mut Node>:= stash.allocate(Node(amount = 1))",
        "    result: Int32:= (^first).amount",
        "    stash.reset()",
        "    second: Ptr<mut Node>:= stash.allocate(Node(amount = 2))",
        "    return result + (^second).amount",
        "end"
      ]},
      "features": ["stash", "heap-allocation", "pointers", "defer"],
      "reservedWords": ["type", "fun", "defer", "return", "end", "do"]
    },
    {
      "id": "memory-pool-fixed-capacity",
      "name": "Pool fixed capacity",
      "description": "Allocate, free, and destroy slots in a fixed-capacity Pool.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Node is struct amount: Int32 end",
        "fun demo(): Int32 do",
        "    pool := Pool<Node>(4)",
        "    defer pool.destroy()",
        "    first: Ptr<mut Node>:= pool.allocate(Node(amount = 10))",
        "    second: Ptr<mut Node>:= pool.allocate(Node(amount = 20))",
        "    result: Int32:= (^first).amount + (^second).amount",
        "    pool.free(first)",
        "    pool.free(second)",
        "    return result",
        "end"
      ]},
      "features": ["pool", "heap-allocation", "pointers", "defer"],
      "reservedWords": ["type", "fun", "defer", "return", "end", "do"]
    }
  ]
}
