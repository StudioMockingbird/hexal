{
  "id": "signals",
  "name": "Signals",
  "snippets": [
    {
      "description": "Subscribe to Interrupt and Hangup, then park on the next() event until one arrives, EoS is reported, or the handle closes.",
      "entrypoint": "app.hex",
      "features": [
        "signals",
        "errors",
        "try-errdefer",
        "collections"
      ],
      "id": "signals-wait-for-shutdown",
      "name": "Wait for a shutdown signal",
      "reservedWords": [
        "fun",
        "do",
        "end",
        "try",
        "defer",
        "return"
      ],
      "sources": {
        "app.hex": [
          "import",
          "   Sig from std.signal",
          "end",
          "fun wait_for_shutdown(): Sig.Signal | EoS | Error do",
          "    wanted: Array\u003cSig.Signal, 2\u003e := [Sig.Signal.Interrupt(), Sig.Signal.Hangup()]",
          "    signals := try Sig.subscribe(wanted.slice(0, wanted.length()))",
          "    defer signals.close()",
          "    signal := try signals.next()",
          "    return signal",
          "end",
          "out: Sig.Signal | EoS | Error := wait_for_shutdown()"
        ]
      }
    }
  ]
}
