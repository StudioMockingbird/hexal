{
  "id": "io-and-concurrency",
  "name": "I/O and Concurrency",
  "snippets": [
    {
      "id": "printing",
      "name": "Structured printing",
      "description": "Printable values are emitted left-to-right without implicit separators.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "type Point = { x: Int32, y: Int32, }",
        "point: Point = Point { x = 3, y = 4 }",
        "print(\"point = \", point, \"\\n\")"
      ]},
      "features": ["print"],
      "reservedWords": ["type"]
    },
    {
      "id": "file-io",
      "name": "File output",
      "description": "A File is opened, written, flushed, and closed explicitly.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun write_report(path: String): Nil | Error",
        "    file: File = try File.open(path, FileMode.Write)",
        "    defer file.close()",
        "    try file.write_text(\"ready\\n\")",
        "    try file.flush()",
        "    return nil",
        "end"
      ]},
      "features": ["file-io"],
      "reservedWords": ["fun", "try", "defer", "return", "nil", "end"]
    },
    {
      "id": "tasks",
      "name": "Tasks",
      "description": "A named function runs as a task and returns a typed result.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun square(value: Int32): Int32",
        "    return value * value",
        "end",
        "fun run(): Int32 | Error",
        "    task: Task<Int32> = try spawn square(6)",
        "    return task.join()",
        "end"
      ]},
      "features": ["tasks"],
      "reservedWords": ["fun", "return", "end", "try", "spawn"]
    },
    {
      "id": "channels",
      "name": "Channels",
      "description": "A bounded channel sends values and marks completion with EoS.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun channel_demo(heap: Heap): Int32 | Error",
        "    channel: Channel<Int32> = try Channel<Int32>.new(heap, 2)",
        "    defer channel.free(heap)",
        "    channel.send(42)",
        "    channel.close()",
        "    step: Int32 | EoS = channel.receive()",
        "    if step is Int32",
        "        return step",
        "    end",
        "    return 0",
        "end"
      ]},
      "features": ["channels"],
      "reservedWords": ["fun", "try", "defer", "if", "is", "return", "end"]
    },
    {
      "id": "mutex",
      "name": "Mutex",
      "description": "A heap-backed mutex protects a short critical section.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun mutex_demo(heap: Heap): Nil | Error",
        "    mutex: Mutex = try Mutex.new(heap)",
        "    defer mutex.free(heap)",
        "    mutex.lock()",
        "    mutex.unlock()",
        "    return nil",
        "end"
      ]},
      "features": ["mutex"],
      "reservedWords": ["fun", "try", "defer", "return", "nil", "end"]
    },
    {
      "id": "atomics",
      "name": "Atomic values",
      "description": "An Atomic integer supports lock-free load/store and read-modify-write operations.",
      "entrypoint": "app.hex",
      "sources": {"app.hex": [
        "fun atomic_demo(): Int32",
        "    counter: Atomic<Int32> = Atomic<Int32>.new(0)",
        "    previous: Int32 = counter.fetch_add(1)",
        "    counter.store(previous + 5)",
        "    return counter.load()",
        "end"
      ]},
      "features": ["atomics"],
      "reservedWords": ["fun", "return", "end"]
    }
  ]
}
